---
import { Image } from 'astro:assets'
import Button from '@/components/Button.astro'

import logoYess from '@/assets/logo-yess.svg'

interface Props {
	class?: string
}

const { class: className } = Astro.props

const navigation = [
	{ label: 'Início', href: '/' },
	{ label: 'Serviços', href: '/#servicos' },
	{ label: 'Portfólio', href: '/portfolio/' },
	{ label: 'Sobre', href: '/sobre/' },
	{ label: 'Contato', href: '/contato/' },
]
---

<header class:list={['px-3 py-3 md:px-8 lg:px-16 lg:pt-6 lg:pb-5', className]}>
	<div
		class="mx-auto flex h-18 w-full max-w-345 items-center justify-between gap-3 overflow-hidden rounded-full border-2 border-stroke bg-surface px-4 py-3 max-[359px]:gap-2 max-[359px]:px-3 lg:h-20 lg:gap-6 lg:px-7.5"
	>
		<a href="/" class="shrink-0" aria-label="YESS Audiovisual e Eventos — início">
			<Image
				src={logoYess}
				alt="YESS Audiovisual e Eventos"
				class="h-12 w-auto max-[359px]:h-10 lg:h-15.5"
			/>
		</a>

		<nav class="hidden items-center gap-7 lg:flex" aria-label="Navegação principal">
			{
				navigation.map((item) => (
					<a
						href={item.href}
						class="font-title text-sm leading-5 font-semibold text-muted transition-colors duration-200 hover:text-foreground"
					>
						{item.label}
					</a>
				))
			}

			<Button
				label="Solicitar orçamento"
				href="#orcamento"
				variant="primary"
				class="w-full md:w-auto"
			/>
		</nav>

		<a
			href="#orcamento"
			class="inline-flex h-12 shrink-0 items-center justify-center rounded-full bg-primary px-4 font-title text-sm leading-5 font-semibold text-foreground transition-colors duration-200 hover:bg-primary-dark max-[359px]:px-3 max-[359px]:text-xs lg:hidden"
		>
			Solicitar orçamento
		</a>
	</div>
</header>
