---
import { locationGroups, locations } from '@/data/landings/locations'
import { getService, inLocation, isPublished, landingURL } from '@/lib/landings'

interface Props {
	/** Slug do serviço em `src/data/landings/services.ts`. */
	service: string
	/** Localidade da página atual, destacada e sem link. */
	currentLocation?: string
	title?: string
}

const { service: serviceSlug, currentLocation, title } = Astro.props
const service = getService(serviceSlug)
const groups = locationGroups
	.map((group) => ({
		title: group.title,
		items: locations.filter((location) => group.match(location) && isPublished(service, location)),
	}))
	.filter((group) => group.items.length > 0)
---

<section class="px-3 py-8 md:px-8 lg:px-16" aria-labelledby={`regioes-${service.slug}`}>
	<div class="mx-auto max-w-345 rounded-3xl border border-stroke bg-surface p-6 md:p-10">
		<h2 id={`regioes-${service.slug}`} class="text-center text-3xl lg:text-left">
			{title ?? `${service.label}: regiões atendidas`}
		</h2>
		<p class="mt-4 max-w-3xl text-center leading-7 text-text-secondary lg:text-left">
			A YESS planeja, entrega, monta e opera a estrutura no local do evento, na capital, na Grande
			São Paulo e no interior. Escolha a região para ver como funciona o atendimento.
		</p>

		<div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
			{
				groups.map((group) => (
					<div>
						<h3 class="text-lg text-primary">{group.title}</h3>
						<ul class="mt-3 flex flex-wrap gap-2">
							{group.items.map((location) => (
								<li>
									{location.slug === currentLocation ? (
										<span
											aria-current="page"
											class="inline-block rounded-full border border-primary bg-primary-soft px-3 py-2 text-sm text-foreground"
										>
											{location.name}
										</span>
									) : (
										<a
											href={landingURL(service, location)}
											title={`${service.label} ${inLocation(location)}`}
											class="inline-block rounded-full border border-stroke px-3 py-2 text-sm text-text-secondary transition-colors hover:border-primary hover:text-foreground focus-visible:outline-2 focus-visible:outline-primary"
										>
											{location.name}
										</a>
									)}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>
