---
import { localSeoPages, serviceLocations } from '@/data/local-seo'
import { southDistrictGroups, quoteAreaURL } from '@/data/service-areas'
interface Props {
	service: string
	label: string
}
const { service, label } = Astro.props
const published = localSeoPages.filter((page) => page.seoEligible && page.service === service)
const places = [
	'São Paulo',
	'Guarulhos',
	'Zona Sul de São Paulo',
	'Zona Oeste de São Paulo',
	'Zona Norte de São Paulo',
]
---

<section class="px-3 py-12 md:px-8 lg:px-16" aria-label={`Localidades para ${label}`}>
	<div class="mx-auto max-w-345 rounded-3xl border border-stroke bg-surface p-6 md:p-10">
		<h2 class="text-center text-3xl lg:text-left">{label}: localidades atendidas</h2>
		<p class="mt-4 max-w-3xl leading-7 text-text-secondary"
			>A YESS planeja, entrega, monta e acompanha a estrutura audiovisual no local do evento.
			Atendemos a capital e o interior de São Paulo. Informe endereço, data e programação para
			avaliarmos a logística e a disponibilidade.</p
		>
		<div class="mt-6 flex flex-wrap gap-3"
			>{
				places.map((name) => {
					const page = published.find((entry) => serviceLocations[entry.location].name === name)
					const href = page
						? `/solucoes/${page.service}/${page.location}/`
						: quoteAreaURL(
								service,
								name.includes('Zona') ? 'São Paulo' : name,
								name.includes('Zona') ? name : '',
							)
					return (
						<a
							href={href}
							class="rounded-full border border-stroke bg-primary-soft px-4 py-3 text-sm hover:border-primary focus-visible:outline-2 focus-visible:outline-primary"
						>
							{page
								? `${label} ${name.includes('Zona') ? 'na' : 'em'} ${name}`
								: `Consultar ${name}`}{' '}
							↗
						</a>
					)
				})
			}</div
		>
		<details class="mt-8 border-t border-stroke pt-6">
			<summary class="cursor-pointer text-xl font-semibold"
				>Zona Sul: distritos e regiões para seu evento</summary
			>
			<p class="mt-4 text-text-secondary"
				>Selecione uma região para solicitar atendimento. Estes links abrem o formulário com serviço
				e local preenchidos; não são páginas individuais de distrito.</p
			>
			<div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
				>{
					southDistrictGroups.map((group) => (
						<div>
							<>
								<h3 class="text-lg text-primary">{group.name}</h3>
								<ul class="mt-3 flex flex-wrap gap-2">
									{group.districts.map((district) => (
										<li>
											<a
												href={quoteAreaURL(service, 'São Paulo', district)}
												class="inline-block rounded-full border border-stroke px-3 py-2 text-sm hover:border-primary"
											>
												{district}
											</a>
										</li>
									))}
								</ul>
							</>
						</div>
					))
				}</div
			>
		</details>
	</div>
</section>
