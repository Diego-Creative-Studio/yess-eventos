---
import { Image } from 'astro:assets'
import Icon from '@/components/Icon.astro'
import LightHalo from '@/components/LightHalo.astro'
import { locationGroups, locations } from '@/data/landings/locations'
import { getService, inLocation, isPublished, landingURL } from '@/lib/landings'

interface Props {
	/** Slug do serviço em `src/data/landings/services.ts`. */
	service: string
	/** Localidade da página atual, destacada e sem link. */
	currentLocation?: string
	/** Primeira linha do título. Padrão: nome do serviço. */
	title?: string
	/** Segunda linha do título, em azul. */
	highlight?: string
}

const { service: serviceSlug, currentLocation, title, highlight } = Astro.props
const service = getService(serviceSlug)

/** Abertos por padrão: as regiões de maior atuação do cliente. */
const openByDefault = ['Capital', 'Zona Sul', 'Zona Oeste', 'Zona Norte']

/** Cor do marcador de cada grupo. */
const groupColors: Record<string, string> = {
	Capital: 'bg-primary',
	'Zona Sul': 'bg-emerald-500',
	'Zona Oeste': 'bg-violet-600',
	'Zona Norte': 'bg-red-500',
	Centro: 'bg-warm',
	'Zona Leste': 'bg-green-600',
	'Grande São Paulo': 'bg-pink-600',
	Interior: 'bg-indigo-500',
	Litoral: 'bg-cyan-500',
}

const groups = locationGroups
	.map((group) => {
		const items = locations.filter(
			(location) => group.match(location) && isPublished(service, location),
		)
		const current = items.some((location) => location.slug === currentLocation)
		return {
			title: group.title,
			items,
			current,
			open: openByDefault.includes(group.title) || current,
		}
	})
	.filter((group) => group.items.length > 0)

// Destaca o grupo da página atual; sem localidade, destaca a Capital.
const highlighted = groups.find((group) => group.current)?.title ?? 'Capital'

const total = groups.reduce((sum, group) => sum + group.items.length, 0)
// Serviços sem página por bairro listam só cidades e zonas; o selo deixa claro
// que os bairros também são atendidos, para o número menor não parecer cobertura menor.
const hasNeighborhoodPages = service.scope.includes('bairro')
const headingId = `regioes-${service.slug}`

const destaques = [
	{ icone: 'montagem', texto: 'Montagem no local do evento' },
	{ icone: 'estrutura', texto: 'Do projeto à desmontagem' },
	{ icone: 'equipe', texto: 'Atendimento direto' },
] as const

/** Remove acentos e caixa para a busca. */
const normalize = (text: string) => text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()
---

<section
	class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5"
	aria-labelledby={headingId}
	data-service-areas
>
	<div
		class="relative mx-auto w-full overflow-hidden rounded-3xl bg-linear-to-br from-background to-primary-soft p-6 md:p-10 lg:max-w-345 lg:p-12"
	>
		<!-- Foto do serviço ao fundo, apagada à esquerda para não brigar com o texto. -->
		<Image
			src={service.image}
			alt=""
			aria-hidden="true"
			loading="lazy"
			width={960}
			class="pointer-events-none absolute top-0 right-0 h-80 w-full mask-b-from-20% mask-l-from-10% object-cover opacity-20 lg:w-2/3"
		/>
		<LightHalo
			data-animate={false}
			class="top-0 right-0"
			color="primary"
			size="md"
			intensity="subtle"
		/>

		<div
			class="relative z-10 flex flex-col items-center gap-6 text-center lg:flex-row lg:items-center lg:justify-between lg:text-left"
		>
			<div class="max-w-3xl">
				<p class="text-sm font-semibold text-primary uppercase">Regiões atendidas</p>
				<h2 id={headingId} class="mt-2 text-3xl text-foreground lg:text-5xl">
					{title ?? `${service.label}:`}
					<span class="block text-primary">{highlight ?? 'regiões atendidas'}</span>
				</h2>
				<p class="mt-4 text-base text-text-secondary lg:text-lg">
					A YESS planeja, entrega, monta e opera a estrutura no local do evento, na capital, na
					Grande São Paulo e no interior. Escolha a região para ver como funciona o atendimento.
				</p>
			</div>

			<div
				class="flex w-full shrink-0 flex-col gap-5 rounded-3xl border border-primary/50 bg-background/60 p-5 backdrop-blur-sm sm:flex-row sm:items-center lg:w-auto"
			>
				<div class="flex items-center justify-center gap-3 sm:justify-start">
					<span class="flex size-12 items-center justify-center rounded-full bg-primary text-white">
						<Icon name="localizacao" class="size-6" />
					</span>
					<span class="text-left">
						<span class="block font-title text-4xl leading-10 font-bold text-primary">{total}</span>
						<span class="block text-sm font-semibold text-foreground">
							{hasNeighborhoodPages ? 'localidades atendidas' : 'cidades e regiões'}
						</span>
						{
							!hasNeighborhoodPages && (
								<span class="block text-xs text-muted">Atendemos todos os bairros da capital.</span>
							)
						}
					</span>
				</div>
				<ul
					class="grid grid-cols-3 gap-3 border-t border-stroke pt-4 sm:border-t-0 sm:border-l sm:pt-0 sm:pl-5"
				>
					{
						destaques.map((item) => (
							<li class="flex max-w-24 flex-col items-center gap-2 justify-self-center text-center text-xs leading-4 text-text-secondary">
								<Icon name={item.icone} class="size-6 text-primary" />
								{item.texto}
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<label
			class="relative z-10 mt-8 flex items-center gap-3 rounded-small border border-primary/40 bg-background/60 px-4 py-3.5 backdrop-blur-sm transition-colors focus-within:border-primary"
		>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
				class="size-5 shrink-0 text-text-secondary"
			>
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			</svg>
			<span class="sr-only">Buscar localidade</span>
			<input
				type="search"
				data-areas-search
				autocomplete="off"
				placeholder={hasNeighborhoodPages
					? 'Digite sua cidade ou bairro…'
					: 'Digite sua cidade ou região…'}
				class="min-w-0 flex-1 bg-transparent text-base text-foreground outline-none placeholder:text-muted [&::-webkit-search-cancel-button]:hidden"
			/>
			<span class="hidden shrink-0 text-xs text-muted md:block">
				Exemplo: {
					hasNeighborhoodPages ? 'Pinheiros, Moema, Campinas' : 'Guarulhos, Campinas, Santos'
				}
			</span>
		</label>

		<p
			data-areas-empty
			hidden
			class="relative z-10 mt-4 rounded-small border border-stroke bg-surface/70 p-4 text-center text-sm text-text-secondary"
		>
			Não encontrou sua região? A YESS também atende outras localidades sob consulta.
			<a href="/contato/#canais" class="font-semibold text-primary hover:underline"
				>Solicite um orçamento</a
			>.
		</p>

		<div class="relative z-10 mt-6 gap-4 md:columns-2 lg:columns-3">
			{
				groups.map((group) => (
					<details
						open={group.open}
						data-areas-group
						data-open-default={group.open ? 'true' : 'false'}
						class:list={[
							'group mb-4 break-inside-avoid rounded-small border bg-surface/70 backdrop-blur-sm transition-colors',
							group.title === highlighted
								? 'border-primary shadow-[0_0_24px_-6px] shadow-primary/60'
								: 'border-stroke open:border-primary/40',
						]}
					>
						<summary class="flex cursor-pointer list-none items-center gap-3 p-4 [&::-webkit-details-marker]:hidden">
							<span
								class:list={[
									'flex size-9 shrink-0 items-center justify-center rounded-full text-white',
									groupColors[group.title] ?? 'bg-primary-soft',
								]}
							>
								<Icon name="localizacao" class="size-4" />
							</span>
							<span class="flex-1 font-title text-lg font-semibold text-foreground">
								{group.title}
							</span>
							<span class="rounded-full border border-primary/40 bg-background/70 px-2.5 py-1 text-xs text-text-secondary">
								{group.items.length} {group.items.length === 1 ? 'local' : 'locais'}
							</span>
							<span class="flex rotate-90 text-muted transition-transform duration-200 group-open:-rotate-90">
								<Icon name="chevron" class="size-2.5" />
							</span>
						</summary>
						<ul class="flex flex-wrap gap-2 border-t border-stroke p-4">
							{group.items.map((location) => (
								<li data-areas-item data-name={normalize(location.name)}>
									{location.slug === currentLocation ? (
										<span
											aria-current="page"
											class="inline-block rounded-full bg-primary px-3 py-1.5 text-sm font-semibold text-white"
										>
											{location.name}
										</span>
									) : (
										<a
											href={landingURL(service, location)}
											title={`${service.label} ${inLocation(location)}`}
											class="inline-block rounded-full border border-stroke bg-background/40 px-3 py-1.5 text-sm text-text-secondary transition-colors hover:border-primary hover:text-foreground focus-visible:outline-2 focus-visible:outline-primary"
										>
											{location.name}
										</a>
									)}
								</li>
							))}
						</ul>
					</details>
				))
			}
		</div>
	</div>
</section>

<script>
	const normalize = (text: string) => text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim()

	document.querySelectorAll<HTMLElement>('[data-service-areas]').forEach((section) => {
		const input = section.querySelector<HTMLInputElement>('[data-areas-search]')
		const empty = section.querySelector<HTMLElement>('[data-areas-empty]')
		const groups = section.querySelectorAll<HTMLDetailsElement>('[data-areas-group]')
		if (!input) return

		input.addEventListener('input', () => {
			const term = normalize(input.value)
			let matches = 0

			groups.forEach((group) => {
				let groupMatches = 0
				group.querySelectorAll<HTMLElement>('[data-areas-item]').forEach((item) => {
					const visible = !term || (item.dataset.name ?? '').includes(term)
					item.hidden = !visible
					if (visible) groupMatches++
				})
				matches += groupMatches
				group.hidden = groupMatches === 0
				// Com busca, abre os grupos encontrados; sem busca, volta ao estado inicial.
				group.open = term ? groupMatches > 0 : group.dataset.openDefault === 'true'
			})

			if (empty) empty.hidden = matches > 0
		})
	})
</script>
