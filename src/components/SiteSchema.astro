---
import logoYess from '@/assets/logo-yess.svg'
import site from '@/data/site.json'

const baseURL = new URL('/', Astro.site ?? Astro.url.origin)
const logoURL = new URL(logoYess.src, baseURL)

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${baseURL.href}#website`,
			url: baseURL.href,
			name: site.siteName,
			alternateName: ['YESS', 'YESS Produções', 'yessproducoes.com.br'],
			inLanguage: 'pt-BR',
			publisher: { '@id': `${baseURL.href}#organization` },
		},
		{
			'@type': 'Organization',
			'@id': `${baseURL.href}#organization`,
			name: 'YESS Audiovisual & Eventos',
			legalName: site.legalName,
			taxID: site.cnpj,
			alternateName: ['YESS', 'YESS Produções'],
			url: baseURL.href,
			logo: {
				'@type': 'ImageObject',
				url: logoURL.href,
			},
			description: site.description,
			areaServed: [
				{ '@type': 'State', name: 'São Paulo' },
				{ '@type': 'City', name: 'São Paulo' },
				{ '@type': 'City', name: 'Guarulhos' },
			],
			knowsAbout: [
				'Painéis de LED P2 e P3',
				'Sonorização para eventos',
				'Iluminação para eventos',
				'TVs e projetores para eventos',
				'Projetos técnicos para eventos',
				'Operação técnica audiovisual',
			],
		},
	],
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
