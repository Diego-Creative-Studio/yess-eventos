---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import heroHome from '@/assets/hero-home.png'
import Button from '@/components/Button.astro'
import Etiqueta from '@/components/Etiqueta.astro'

interface Cta {
	label: string
	href: string
}

interface Props {
	eyebrow?: string
	titleStrong?: string
	title?: string
	description?: string
	image?: ImageMetadata
	imageAlt?: string
	primaryCta?: Cta
	secondaryCta?: Cta
	features?: string[]
	corFundoEtiqueta?: string
	corTextoEtiqueta?: string
	corBolinhaEtiqueta?: string
	videoMp4?: string
	videoWebm?: string
}

const {
	eyebrow = 'Painéis de LED P2 e P3 para eventos',
	titleStrong = 'Painéis de LED para eventos corporativos.',
	title = 'Que precisam impressionar.',
	description = 'Locação de painéis P2 e P3, som, iluminação e TVs, com montagem e operação técnica.',
	image = heroHome,
	imageAlt = 'Evento corporativo com grandes painéis de LED azuis',
	primaryCta = { label: 'Solicitar orçamento', href: '#contato' },
	secondaryCta = { label: 'Conhecer soluções', href: '#servicos' },
	features = ['Planejamento', 'Montagem', 'Operação técnica'],
	corFundoEtiqueta = 'bg-violet-dark',
	corTextoEtiqueta = 'text-foreground',
	corBolinhaEtiqueta = 'bg-foreground',
	videoMp4 = '/videos/hero-home.mp4',
	videoWebm = '/videos/hero-home.webm',
} = Astro.props
---

<section data-hero-stage class="px-3 pt-4 pb-8 md:px-8 lg:px-16 lg:pt-5 lg:pb-16">
	<div
		data-hero-shell
		class="relative container mx-auto flex w-full origin-center items-center overflow-hidden rounded-hero bg-surface px-6 py-10 max-[359px]:px-4 md:max-w-7xl md:px-10 lg:max-w-345 lg:pt-16 lg:pr-9 lg:pb-22 lg:pl-14"
	>
		<video
			data-hero-video
			muted
			playsinline
			preload="none"
			poster={image.src}
			aria-hidden="true"
			class="will-change-opacity pointer-events-none absolute inset-0 size-full object-cover object-[58%_center] opacity-0 lg:object-center"
		>
			<source data-hero-video-source data-src={videoWebm} type="video/webm" />
			<source data-hero-video-source data-src={videoMp4} type="video/mp4" />
		</video>

		<Image
			data-hero-poster
			src={image}
			alt={imageAlt}
			fetchpriority="high"
			class="will-change-opacity absolute inset-0 size-full object-cover object-[58%_center] lg:object-center"
		/>
		<div
			data-hero-overlay
			class="absolute inset-0 bg-linear-to-t from-background/95 from-20% to-transparent to-80% lg:bg-linear-to-r lg:from-20% lg:to-60%"
			aria-hidden="true"></div>

		<div
			data-hero-content
			class="relative z-10 flex w-full max-w-197.5 flex-col items-center gap-4.5 text-center lg:h-146 lg:max-w-200 lg:items-start lg:overflow-hidden lg:text-left"
		>
			<Etiqueta
				animar
				texto={eyebrow}
				corFundo={corFundoEtiqueta}
				corTexto={corTextoEtiqueta}
				corBolinha={corBolinhaEtiqueta}
				class="self-center lg:self-start lg:text-left"
			/>

			<h1
				data-animate
				class="w-full pt-2 text-4xl uppercase max-[359px]:text-3xl md:max-w-5xl md:text-5xl lg:text-6xl"
			>
				<span class="font-extrabold" set:html={titleStrong} />{' '}
				<span class="font-semibold" set:html={title} />
			</h1>

			<p
				data-animate
				class="w-full text-base text-foreground/80 md:max-w-147.5 md:text-lg"
				set:html={description}
			/>

			<div
				data-animate
				class="flex w-full flex-col items-center justify-center gap-3 md:w-auto md:flex-row lg:justify-start"
			>
				<Button
					label={primaryCta.label}
					href={primaryCta.href}
					variant="primary"
					arrow
					class="w-full md:w-auto"
					animation="shine"
				/>
				<Button
					label={secondaryCta.label}
					href={secondaryCta.href}
					variant="outline"
					class="w-full md:w-auto"
					animation="shine"
				/>
			</div>

			<ul
				data-animate
				class="flex w-full list-none flex-wrap items-center justify-center gap-x-5.5 gap-y-2 pt-5 font-title text-sm text-muted md:text-base lg:w-auto lg:justify-start"
			>
				{
					features.map((feature, index) => (
						<li class="flex items-center gap-2">
							<span
								class:list={['size-1.5 rounded-full', index === 1 ? 'bg-primary' : 'bg-foreground']}
								aria-hidden="true"
							/>
							<span set:html={feature} />
						</li>
					))
				}
			</ul>

			<Button
				id="hero-mobile-play"
				label="Assistir vídeo"
				type="button"
				variant="outline"
				icon="play"
				animation="shine"
				class="mt-1 cursor-pointer bg-background/70 backdrop-blur-md lg:hidden"
			/>
		</div>

		<Button
			id="hero-replay"
			label="Rever vídeo"
			type="button"
			variant="outline"
			icon="play"
			animation="shine"
			class="pointer-events-none !absolute right-[clamp(32px,4vw,72px)] bottom-8 z-20 hidden translate-y-2 cursor-pointer bg-background/70 opacity-0 backdrop-blur-md lg:inline-flex"
		/>
	</div>
</section>

<script>
	import { gsap } from 'gsap'

	const heroShell = document.querySelector<HTMLElement>('[data-hero-shell]')
	const heroStage = document.querySelector<HTMLElement>('[data-hero-stage]')
	const homeHeader = document.querySelector<HTMLElement>('.home-header')
	const headerContainer = homeHeader?.querySelector<HTMLElement>('[data-header-container]')
	const headerSurface = homeHeader?.querySelector<HTMLElement>('[data-header-surface]')

	if (heroShell && heroStage && heroShell.dataset.videoInitialized !== 'true') {
		heroShell.dataset.videoInitialized = 'true'

		const video = heroShell.querySelector<HTMLVideoElement>('[data-hero-video]')
		const poster = heroShell.querySelector<HTMLElement>('[data-hero-poster]')
		const overlay = heroShell.querySelector<HTMLElement>('[data-hero-overlay]')
		const heroContent = heroShell.querySelector<HTMLElement>('[data-hero-content]')
		const replayButton = heroShell.querySelector<HTMLButtonElement>('#hero-replay')
		const mobilePlayButton = heroShell.querySelector<HTMLButtonElement>('#hero-mobile-play')
		const mobilePlayLabel = mobilePlayButton?.querySelector<HTMLElement>('span')
		const videoSources = heroShell.querySelectorAll<HTMLSourceElement>('[data-hero-video-source]')
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
		const desktopQuery = window.matchMedia('(min-width: 1024px)')
		const disableDesktopSequence = ['localhost', '127.0.0.1', '::1'].includes(
			window.location.hostname,
		)
		const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
		const saveData = connection?.saveData === true
		let sourcesAttached = false

		const attachVideoSources = () => {
			if (!video || sourcesAttached) return

			videoSources.forEach((source) => {
				const sourceUrl = source.dataset.src
				if (sourceUrl) source.src = sourceUrl
			})
			video.load()
			sourcesAttached = true
		}

		if (
			video &&
			poster &&
			overlay &&
			heroContent &&
			replayButton &&
			headerContainer &&
			headerSurface &&
			desktopQuery.matches &&
			!disableDesktopSequence &&
			!reduceMotion &&
			!saveData
		) {
			attachVideoSources()

			let revealed = false
			let sequenceComplete = false
			let videoEnded = false
			let transitionTimeline: gsap.core.Timeline | undefined
			let revealTimer = 0
			let collapseTimer = 0
			const revealAt = Date.now() + 3000

			const collapseHero = () => {
				if (!transitionTimeline || sequenceComplete) return

				sequenceComplete = true
				collapseTimer = window.setTimeout(() => {
					transitionTimeline?.eventCallback('onReverseComplete', () => {
						video.pause()
						video.currentTime = 0
						revealed = false
						replayButton.style.pointerEvents = 'auto'
						gsap.fromTo(
							replayButton,
							{ autoAlpha: 0, y: 8 },
							{ autoAlpha: 1, y: 0, duration: 0.35, ease: 'power2.out' },
						)
					})
					transitionTimeline?.reverse()
				}, 700)
			}

			const revealVideo = async () => {
				if (revealed || !desktopQuery.matches) return
				sequenceComplete = false
				videoEnded = false
				replayButton.style.pointerEvents = 'none'
				gsap.to(replayButton, { autoAlpha: 0, y: 8, duration: 0.2, ease: 'power2.in' })

				try {
					await video.play()
				} catch {
					return
				}

				revealed = true
				const headerHeight = homeHeader?.offsetHeight ?? 0
				transitionTimeline = gsap
					.timeline({
						defaults: { ease: 'power3.inOut' },
						onComplete: () => {
							if (videoEnded) collapseHero()
						},
					})
					.to(
						heroStage,
						{
							marginTop: -headerHeight,
							paddingTop: 0,
							paddingRight: 0,
							paddingBottom: 0,
							paddingLeft: 0,
							duration: 2.6,
						},
						0,
					)
					.to(
						heroShell,
						{
							maxWidth: '100%',
							minHeight: '100svh',
							paddingLeft: 'clamp(72px, 7vw, 144px)',
							borderRadius: 0,
							duration: 2.6,
						},
						0,
					)
					.to(homeHeader, { paddingRight: 0, paddingLeft: 0, duration: 2.6 }, 0)
					.to(headerContainer, { maxWidth: '100%', duration: 2.6 }, 0)
					.to(video, { autoAlpha: 1, duration: 1.8 }, 0.05)
					.to(poster, { autoAlpha: 0, duration: 1.4 }, 0.35)
					.to(overlay, { opacity: 0.88, duration: 1.6 }, 0.25)
					.set(
						headerSurface,
						{
							boxShadow: 'none',
							backdropFilter: 'none',
						},
						0.35,
					)
					.to(
						headerSurface,
						{
							paddingRight: 'clamp(72px, 7vw, 144px)',
							paddingLeft: 'clamp(72px, 7vw, 144px)',
							backgroundColor: 'transparent',
							borderColor: 'transparent',
							duration: 1.8,
						},
						0.35,
					)
			}

			video.addEventListener('ended', () => {
				videoEnded = true
				if ((transitionTimeline?.progress() ?? 0) >= 0.999) collapseHero()
			})

			replayButton.addEventListener('click', () => {
				transitionTimeline?.kill()
				video.currentTime = 0
				revealVideo()
			})

			const scheduleReveal = () => {
				if (!desktopQuery.matches) return
				const remainingDelay = Math.max(0, revealAt - Date.now())
				revealTimer = window.setTimeout(revealVideo, remainingDelay)
			}

			if (video.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) scheduleReveal()
			else video.addEventListener('canplay', scheduleReveal, { once: true })

			document.addEventListener('visibilitychange', () => {
				if (!revealed || sequenceComplete) return
				if (document.hidden) video.pause()
				else video.play().catch(() => undefined)
			})

			desktopQuery.addEventListener('change', (event) => {
				if (event.matches) return

				window.clearTimeout(revealTimer)
				window.clearTimeout(collapseTimer)
				transitionTimeline?.kill()
				gsap.killTweensOf([
					heroStage,
					heroShell,
					homeHeader,
					headerContainer,
					headerSurface,
					video,
					poster,
					overlay,
					replayButton,
				])
				video.pause()
				video.currentTime = 0
				revealed = false
				sequenceComplete = false
				videoEnded = false
				transitionTimeline = undefined

				gsap.set(heroStage, {
					clearProps: 'marginTop,paddingTop,paddingRight,paddingBottom,paddingLeft',
				})
				gsap.set(heroShell, {
					clearProps: 'maxWidth,minHeight,paddingLeft,borderRadius',
				})
				gsap.set(homeHeader, { clearProps: 'paddingRight,paddingLeft' })
				gsap.set(headerContainer, { clearProps: 'maxWidth' })
				gsap.set(headerSurface, {
					clearProps:
						'paddingRight,paddingLeft,backgroundColor,borderColor,boxShadow,backdropFilter',
				})
				gsap.set(video, { clearProps: 'opacity,visibility,transform' })
				gsap.set(poster, { clearProps: 'opacity,visibility' })
				gsap.set(overlay, { clearProps: 'opacity' })
				gsap.set(replayButton, {
					clearProps: 'opacity,visibility,transform,pointerEvents',
				})
			})
		}

		if (video && poster && mobilePlayButton && mobilePlayLabel) {
			let mobilePlaying = false

			const playOnMobile = async () => {
				if (desktopQuery.matches || mobilePlaying) return
				attachVideoSources()
				mobilePlayButton.disabled = true

				try {
					video.currentTime = 0
					await video.play()
				} catch {
					mobilePlayButton.disabled = false
					return
				}

				mobilePlaying = true
				gsap.to(mobilePlayButton, { autoAlpha: 0, duration: 0.2 })
				gsap.to(video, { autoAlpha: 1, duration: 0.8, ease: 'power2.out' })
				gsap.to(poster, { autoAlpha: 0, duration: 0.65, ease: 'power2.out' })
			}

			mobilePlayButton.addEventListener('click', playOnMobile)
			video.addEventListener('ended', () => {
				if (!mobilePlaying) return

				gsap
					.timeline({
						onComplete: () => {
							mobilePlaying = false
							mobilePlayButton.disabled = false
							mobilePlayLabel.textContent = 'Rever vídeo'
							video.currentTime = 0
						},
					})
					.to(video, { autoAlpha: 0, duration: 0.5, ease: 'power2.inOut' })
					.to(poster, { autoAlpha: 1, duration: 0.5, ease: 'power2.inOut' }, 0)
					.to(mobilePlayButton, { autoAlpha: 1, duration: 0.25 }, 0.3)
			})
		}
	}
</script>
