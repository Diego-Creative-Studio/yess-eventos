---
import { Image } from 'astro:assets'

import helvetia from '@/assets/parceiros/clube-helvetia.png'
import apcef from '@/assets/parceiros/apcef-sp.png'
import mesaAfins from '@/assets/parceiros/mesa-e-afins.png'
import velocity from '@/assets/parceiros/studio-velocity.png'
import urbia from '@/assets/parceiros/urbia.png'
import corinthians from '@/assets/parceiros/corinthians.jpg'
import acesc from '@/assets/parceiros/acesc.png'
import rosmarino from '@/assets/parceiros/rosmarino.svg'

const marcas = [
	{ nome: 'Clube Helvétia', logo: helvetia },
	{ nome: 'APCEF/SP', logo: apcef },
	{ nome: 'Mesa & Afins · Célia Mineiro', logo: mesaAfins },
	{ nome: 'Studio Velocity', logo: velocity },
	{ nome: 'Urbia', logo: urbia, escuro: true },
	{ nome: 'Corinthians', logo: corinthians },
	{ nome: 'ACESC', logo: acesc },
	{ nome: 'Rosmarino', logo: rosmarino, escuro: true },
]
---

<section
	id="clientes"
	data-marcas
	data-active="false"
	aria-labelledby="marcas-titulo"
	class="overflow-hidden bg-background py-10 lg:py-14"
>
	<div class="mx-auto max-w-345 px-3 text-center md:px-8 lg:px-0">
		<p class="text-sm font-semibold text-warm uppercase">Quem já atendemos</p>
		<h2 id="marcas-titulo" class="mt-2 text-3xl text-foreground lg:text-4xl">
			Clientes atendidos.
		</h2>
	</div>

	<!-- As cópias mantêm a faixa contínua; leitores de tela leem apenas a primeira. -->
	<div class="marcas-faixa mt-8 flex overflow-hidden mask-x-from-90% mask-x-to-100%">
		{
			[0, 1, 2].map((copy) => (
				<ul class="marcas-lista flex w-max shrink-0" aria-hidden={copy > 0 ? 'true' : undefined}>
					{marcas.map((marca) => (
						<li class="w-40 shrink-0 px-2 lg:w-50 lg:px-3">
							<div
								class:list={[
									'flex h-24 items-center justify-center rounded-small px-4 py-3 lg:h-28',
									marca.escuro ? 'border border-stroke bg-surface' : 'bg-white',
								]}
							>
								<Image
									src={marca.logo}
									alt={copy > 0 ? '' : marca.nome}
									loading="lazy"
									class="h-auto max-h-full w-auto max-w-full object-contain"
								/>
							</div>
							<p class="mt-3 text-center text-xs leading-5 text-text-secondary">{marca.nome}</p>
						</li>
					))}
				</ul>
			))
		}
	</div>
</section>

<style>
	.marcas-lista {
		animation: marcas-slide 40s linear infinite;
	}
	[data-active='false'] .marcas-lista,
	.marcas-faixa:hover .marcas-lista {
		animation-play-state: paused;
	}
	@keyframes marcas-slide {
		to {
			transform: translateX(-100%);
		}
	}
	/* Sem movimento, todas as marcas ficam disponíveis em uma grade estática. */
	@media (prefers-reduced-motion: reduce) {
		.marcas-faixa {
			justify-content: center;
			mask-image: none;
		}
		.marcas-lista {
			width: auto;
			flex-wrap: wrap;
			justify-content: center;
			gap: 1.5rem 0;
			animation: none;
		}
		.marcas-lista[aria-hidden='true'] {
			display: none;
		}
	}
	:global(html:not(.js)) .marcas-faixa {
		justify-content: center;
		mask-image: none;
	}
	:global(html:not(.js)) .marcas-lista {
		width: auto;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5rem 0;
		animation: none;
	}
	:global(html:not(.js)) .marcas-lista[aria-hidden='true'] {
		display: none;
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>('[data-marcas]')
	if (section) {
		let inView = false
		const update = () => {
			section.dataset.active = String(inView && !document.hidden)
		}
		new IntersectionObserver(([entry]) => {
			inView = entry.isIntersecting
			update()
		}).observe(section)
		document.addEventListener('visibilitychange', update)
	}
</script>
