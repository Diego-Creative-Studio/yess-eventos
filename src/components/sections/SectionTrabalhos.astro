---
import { Image } from 'astro:assets'

import imageEvent from '@/assets/yess/evento-corporativo-gala.jpg'
import imageLed from '@/assets/yess/painel-led-panoramico.jpg'
import imageSoundAndLighting from '@/assets/yess/som-e-luz-show.jpg'
import imageOperation from '@/assets/yess/operacao-tecnica-mesa.jpg'
---

<section
	id="trabalhos"
	aria-labelledby="titulo-trabalhos"
	class="overflow-hidden bg-background px-3 py-12 md:px-8 lg:px-16 lg:py-16"
>
	<div data-animate="fade-up" class="mx-auto flex w-full flex-col gap-8 lg:max-w-345 lg:gap-0">
		<div data-animate class="flex flex-col gap-2 text-center md:text-left lg:min-h-27.5">
			<p class="text-sm font-semibold text-warm uppercase">Trabalhos realizados</p>
			<h2 data-motion-title id="titulo-trabalhos" class="text-3xl text-foreground lg:text-4xl">
				Projetos audiovisuais em eventos reais.
			</h2>
		</div>

		<div class="mt-2 grid gap-6 lg:h-130 lg:grid-cols-[minmax(0,650fr)_minmax(0,638fr)]">
			<span
				data-motion-image
				class="group relative min-h-96 overflow-hidden rounded-3xl border-2 border-stroke lg:h-130"
			>
				<div class="absolute inset-0 lg:inset-auto lg:top-0 lg:-left-34.25 lg:h-130 lg:w-231">
					<video
						data-trabalho-video
						autoplay
						muted
						loop
						playsinline
						preload="metadata"
						poster={imageEvent.src}
						aria-hidden="true"
						class="size-full object-cover"
					>
						<source src="/videos/evento-corporativo-gala-muted.webm" type="video/webm" />
						<source src="/videos/evento-corporativo-gala-muted.mp4" type="video/mp4" />
					</video>
				</div>
				<span
					aria-hidden="true"
					class="pointer-events-none absolute -top-24 -right-32 size-104 rounded-full bg-primary/20 blur-3xl"
				></span>
				<div
					class="absolute inset-0 bg-linear-to-t from-background from-20% to-transparent to-50% lg:from-10% lg:to-40%"
					aria-hidden="true"></div>
				<p class="absolute bottom-10 left-9 text-foreground lg:text-lg">Evento corporativo </p>
			</span>

			<div class="grid gap-6 lg:grid-rows-2">
				<span
					data-motion-image
					data-motion-parallax
					class="group relative min-h-64 overflow-hidden rounded-3xl border-2 border-stroke lg:min-h-0"
				>
					<div
						class="trabalho-pan trabalho-pan--horizontal absolute inset-0 lg:inset-auto lg:-top-16.25 lg:left-0 lg:h-89.75 lg:w-full"
					>
						<Image
							src={imageLed}
							alt="Palco com um painel de LED panorâmico"
							class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
						/>
					</div>
					<span
						aria-hidden="true"
						class="pointer-events-none absolute -top-11 right-1/4 size-50 rounded-full bg-primary/20 blur-3xl"
					></span>
					<div
						class="absolute inset-0 bg-linear-to-t from-background from-20% to-transparent to-50% lg:from-10% lg:to-40%"
						aria-hidden="true"></div>
					<p class="absolute bottom-7 left-7 text-foreground lg:text-lg">Painel de LED</p>
				</span>

				<div class="grid gap-6 lg:grid-cols-2 lg:gap-4.5">
					<span
						data-motion-image
						class="group relative min-h-64 overflow-hidden rounded-3xl border-2 border-stroke lg:min-h-0"
					>
						<div class="absolute inset-0 lg:inset-auto lg:top-0 lg:-left-6 lg:h-50.25 lg:w-89.25">
							<video
								data-trabalho-video
								autoplay
								muted
								loop
								playsinline
								preload="metadata"
								poster={imageSoundAndLighting.src}
								aria-hidden="true"
								class="size-full object-cover"
							>
								<source src="/videos/iluminacao-cenica-muted.webm" type="video/webm" />
								<source src="/videos/iluminacao-cenica-muted.mp4" type="video/mp4" />
							</video>
						</div>
						<span
							aria-hidden="true"
							class="pointer-events-none absolute -top-11 right-1/4 size-50 rounded-full bg-primary/20 blur-3xl"
						></span>
						<div
							class="absolute inset-0 bg-linear-to-t from-background from-20% to-transparent to-50% lg:from-10% lg:to-40%"
							aria-hidden="true"></div>
						<p class="absolute bottom-7 left-7 text-foreground lg:text-lg">
							Sonorização + Iluminação
						</p>
					</span>

					<a
						href="/dj-para-eventos-corporativos/"
						aria-label="Conhecer o serviço de DJ corporativo"
						data-motion-image
						class="group relative min-h-64 overflow-hidden rounded-3xl border-2 border-stroke focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary lg:min-h-0"
					>
						<div
							class="absolute inset-0 lg:inset-auto lg:-top-9 lg:-left-5.75 lg:h-64.25 lg:w-118.75"
						>
							<video
								data-trabalho-video
								autoplay
								muted
								loop
								playsinline
								preload="metadata"
								poster={imageOperation.src}
								aria-hidden="true"
								class="size-full object-cover"
							>
								<source src="/videos/sonoplastia-e-dj-muted.webm" type="video/webm" />
								<source src="/videos/sonoplastia-e-dj-muted.mp4" type="video/mp4" />
							</video>
						</div>
						<span
							aria-hidden="true"
							class="pointer-events-none absolute -top-11 right-1/4 size-50 rounded-full bg-primary/20 blur-3xl"
						></span>
						<div
							class="absolute inset-0 bg-linear-to-t from-background from-20% to-transparent to-50% lg:from-10% lg:to-40%"
							aria-hidden="true"></div>
						<p class="absolute bottom-7 left-7 text-foreground lg:text-lg"
							>Sonoplastia e DJ corporativo</p
						>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.trabalho-pan--horizontal {
			animation: trabalho-pan-horizontal 12s ease-in-out infinite alternate;
		}
	}

	@keyframes trabalho-pan-horizontal {
		from {
			transform: scale(1.04) translate3d(-1.5%, 0, 0);
		}
		to {
			transform: scale(1.1) translate3d(1.5%, 0, 0);
		}
	}
</style>

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
	// Os arquivos destes cards não contêm áudio; mantém também o estado mudo no player.
	document.querySelectorAll<HTMLVideoElement>('[data-trabalho-video]').forEach((video) => {
		video.defaultMuted = true
		video.muted = true
		video.volume = 0
		if (reducedMotion) {
			video.pause()
			video.currentTime = 0
		}
	})
</script>
