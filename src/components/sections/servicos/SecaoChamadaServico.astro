---
import Icone from '@/components/Icon.astro'

interface Props {
	id?: string
	titulo: string
	descricao: string
	textoBotao: string
	linkBotao: string
}

const { id = 'orcamento', titulo, descricao, textoBotao, linkBotao } = Astro.props
---

<section {id} class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5">
	<div
		data-animate
		class="mx-auto flex w-full flex-col gap-8 rounded-3xl border-2 border-primary bg-linear-to-r from-primary-soft to-primary p-7 lg:min-h-65 lg:max-w-345 lg:flex-row lg:items-center lg:justify-between lg:px-9"
	>
		<div
			><h2 class="font-title text-3xl text-foreground lg:text-4xl" set:html={titulo} /><p
				class="mt-2 text-base text-foreground/75 lg:text-lg"
				set:html={descricao}
			/></div
		>
		<a
			href={linkBotao}
			class="inline-flex min-h-13.5 w-full items-center justify-center gap-3 rounded-pill bg-white px-6 py-4 font-title text-sm font-semibold text-background transition-colors hover:bg-background hover:text-foreground md:w-auto lg:mr-16 lg:min-w-64"
			><span set:html={textoBotao} /><Icone name="arrow" class="size-4" /></a
		>
	</div>
</section>
