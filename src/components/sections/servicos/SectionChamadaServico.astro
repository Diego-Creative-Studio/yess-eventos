---
import Icone from '@/components/Icon.astro'

interface Props {
	id?: string
	titulo: string
	descricao: string
	textoBotao: string
	linkBotao: string
}

const { id = 'orcamento', titulo, descricao, textoBotao, linkBotao } = Astro.props
---

<section {id} class="px-3 py-8 md:px-8 lg:px-16 lg:pt-8 lg:pb-24">
	<div
		data-animate
		class="mx-auto flex w-full flex-col gap-8 rounded-3xl border-2 border-primary bg-linear-to-r from-primary-soft to-primary p-7 lg:min-h-48 lg:max-w-345 lg:flex-row lg:items-center lg:justify-between lg:px-8"
	>
		<div
			><h2 class="text-3xl text-foreground text-shadow-lg lg:text-4xl" set:html={titulo} /><p
				class="mt-2 text-base text-foreground/75 text-shadow-lg lg:text-lg"
				set:html={descricao}
			/></div
		>
		<a
			href={linkBotao}
			class="inline-flex min-h-13.5 w-full items-center justify-between gap-3 rounded-full bg-white px-8 py-6 font-title text-sm font-semibold text-background shadow-xl/20 transition-colors hover:bg-background hover:text-foreground md:h-19 md:w-[359px] md:min-w-[359px] md:px-[50px] md:py-0 md:text-[17px] md:leading-[21px] md:whitespace-nowrap"
			><span set:html={textoBotao} /><Icone name="arrow" class="size-5" /></a
		>
	</div>
</section>
