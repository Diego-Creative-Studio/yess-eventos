---
import AnimatedWaves from '@/components/AnimatedWaves.astro'
interface OpcaoComparacao {
	codigo: string
	etiqueta: string
	titulo: string
	descricao: string
	itens: string[]
}

interface Props {
	etiqueta: string
	titulo: string
	etiquetaOrientacao: string
	descricaoOrientacao: string
	marcadorItem?: '-' | '•'
	compactarCodigoDestaqueNoMobile?: boolean
	opcaoClara: OpcaoComparacao
	opcaoDestaque: OpcaoComparacao
	nota: string
	resumo: string
}

const {
	etiqueta,
	titulo,
	etiquetaOrientacao,
	descricaoOrientacao,
	marcadorItem = '-',
	compactarCodigoDestaqueNoMobile = false,
	opcaoClara,
	opcaoDestaque,
	nota,
	resumo,
} = Astro.props
---

<section class="px-3 py-8 md:px-8 lg:px-16 lg:py-0">
	<div
		class="mx-auto w-full overflow-hidden rounded-3xl border-2 border-stroke bg-background p-6 lg:max-w-345 lg:p-10"
	>
		<header class="grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-end">
			<div data-animate="fade-left">
				<p class="text-sm font-semibold text-primary uppercase" set:html={etiqueta} />
				<h2 class="mt-2 max-w-180 text-3xl text-foreground lg:text-5xl" set:html={titulo} />
			</div>
			<div data-animate="fade-right" data-animate-delay={0.1}>
				<p class="text-sm font-semibold text-primary uppercase" set:html={etiquetaOrientacao} />
				<p class="mt-2 text-base text-muted lg:text-lg" set:html={descricaoOrientacao} />
			</div>
		</header>

		<div class="mt-8 grid gap-6 xl:grid-cols-[2fr_3fr]">
			<article
				data-animate="fade-left"
				data-animate-delay={0.15}
				class="relative isolate flex flex-col overflow-hidden rounded-3xl bg-white p-6 text-background lg:p-8"
			>
				<div class="relative z-10 flex items-start justify-between gap-4"
					><p class="text-6xl leading-[1.05] font-extrabold text-warm uppercase"
						>{opcaoClara.codigo}</p
					><p class="text-xs font-semibold uppercase" set:html={opcaoClara.etiqueta} /></div
				>
				<AnimatedWaves
					class="-right-72 -bottom-72 w-180 lg:-bottom-80 lg:-left-12 lg:w-250"
					color="bg-primary-dark"
					opacity="opacity-50"
					echoOpacity="opacity-20"
				/>
				<h3 class="relative z-10 text-2xl font-semibold lg:text-3xl" set:html={opcaoClara.titulo} />
				<p class="relative z-10 mt-3 text-sm text-background/70" set:html={opcaoClara.descricao} />
				<ol class="relative z-10 mt-7 text-sm font-semibold xl:mt-auto xl:pt-7"
					>{
						opcaoClara.itens.map((item, indice) => (
							<li class="flex items-baseline gap-2 border-b border-background/10 py-4">
								<>
									<strong class="w-8 shrink-0">{String(indice + 1).padStart(2, '0')}</strong>
									<span class="w-3 shrink-0" aria-hidden="true">
										{marcadorItem}
									</span>
									<span class="min-w-0 flex-1" set:html={item} />
								</>
							</li>
						))
					}</ol
				>
			</article>

			<article
				data-animate="fade-right"
				data-animate-delay={0.25}
				class="relative isolate flex flex-col overflow-hidden rounded-3xl bg-primary p-6 text-foreground lg:p-8"
			>
				<div class="relative z-10 flex items-start justify-between gap-4"
					><p
						class:list={[
							'leading-[1.05] font-extrabold uppercase',
							compactarCodigoDestaqueNoMobile
								? 'text-3xl min-[360px]:text-[2.5rem] lg:text-6xl'
								: 'text-6xl',
						]}
					>
						{opcaoDestaque.codigo}
					</p><p class="text-xs font-semibold uppercase" set:html={opcaoDestaque.etiqueta} /></div
				>

				<AnimatedWaves
					class="-right-72 -bottom-72 w-180 lg:-right-90 lg:-bottom-90 lg:w-260"
					color="bg-white"
					opacity="opacity-80"
					echoOpacity="opacity-30"
				/>

				<h3
					class="relative z-10 text-2xl font-semibold lg:text-3xl"
					set:html={opcaoDestaque.titulo}
				/>
				<p
					class="relative z-10 mt-3 text-sm text-foreground/75"
					set:html={opcaoDestaque.descricao}
				/>
				<ol class="relative z-10 mt-7 text-sm font-semibold xl:mt-auto xl:pt-7"
					>{
						opcaoDestaque.itens.map((item, indice) => (
							<li class="flex items-baseline gap-2 border-b border-white/20 py-4">
								<>
									<strong class="w-8 shrink-0">{String(indice + 1).padStart(2, '0')}</strong>
									<span class="w-3 shrink-0" aria-hidden="true">
										{marcadorItem}
									</span>
									<span class="min-w-0 flex-1" set:html={item} />
								</>
							</li>
						))
					}</ol
				>
			</article>
		</div>

		<div
			data-animate="fade-up"
			data-animate-delay={0.35}
			class="mt-6 flex flex-col gap-2 text-sm text-muted md:flex-row md:items-center md:justify-between"
			><p set:html={nota} /><p class="font-semibold text-primary" set:html={resumo} /></div
		>
	</div>
</section>
