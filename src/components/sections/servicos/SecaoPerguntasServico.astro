---
interface Pergunta {
	pergunta: string
	resposta: string
}

interface Props {
	titulo: string
	perguntas: [Pergunta, Pergunta, Pergunta, Pergunta]
}

const { titulo, perguntas } = Astro.props
const fundos = [
	'bg-primary',
	'bg-primary-soft',
	'border-2 border-stroke bg-surface',
	'bg-surface-alt',
]
---

<section class="px-3 py-8 md:px-8 lg:px-16 lg:pt-5 lg:pb-7.5">
	<div
		data-animate
		class="mx-auto w-full rounded-3xl border-2 border-stroke bg-linear-to-br from-background to-primary-soft p-6 lg:max-w-345 lg:p-10"
	>
		<h2 class="font-title text-3xl text-foreground lg:text-4xl" set:html={titulo} />
		<div class="mt-8 grid gap-4 md:grid-cols-2"
			>{
				perguntas.map((item, indice) => (
					<article class:list={['rounded-small p-6', fundos[indice]]}>
						<>
							<h3 class="font-title text-base text-foreground" set:html={item.pergunta} />
							<p
								class:list={['mt-2 text-sm', indice === 0 ? 'text-foreground/80' : 'text-muted']}
								set:html={item.resposta}
							/>
						</>
					</article>
				))
			}</div
		>
	</div>
</section>
