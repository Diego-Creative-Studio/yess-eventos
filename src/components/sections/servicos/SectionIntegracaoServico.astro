---
import Button from '@/components/Button.astro'
import LightHalo from '@/components/LightHalo.astro'

interface Link {
	label: string
	href: string
}

interface Props {
	etiqueta?: string
	titulo: string
	descricao: string
	/** Página relacionada (botão contornado). */
	secundario: Link
	/** Ação principal (botão azul). */
	principal?: Link
}

const {
	etiqueta = 'Entrega integrada',
	titulo,
	descricao,
	secundario,
	principal = {
		label: 'Ver equipamentos e serviços',
		href: '/estrutura-audiovisual-para-eventos/',
	},
} = Astro.props

const sistemas = [
	{ titulo: 'Painel de LED', texto: 'P2 e P3 com processadora e sinal testado.' },
	{ titulo: 'Som', texto: 'P.A., mesas digitais e microfones sem fio.' },
	{ titulo: 'Iluminação', texto: 'Moving heads, par LEDs e mesa de luz.' },
	{ titulo: 'Estrutura', texto: 'Box Truss, praticáveis e backdrops.' },
]
---

<section class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5" aria-labelledby="integracao">
	<div
		class="relative mx-auto grid w-full gap-8 overflow-hidden rounded-3xl border-2 border-stroke bg-linear-to-br from-background to-primary-soft p-6 md:p-10 lg:max-w-345 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-12 lg:p-12"
	>
		<LightHalo
			data-animate={false}
			class="bottom-0 left-0"
			color="primary"
			size="md"
			intensity="medium"
		/>

		<div data-animate="fade-left" class="relative z-10 text-center lg:text-left">
			<p class="text-sm font-semibold text-primary uppercase">{etiqueta}</p>
			<h2 id="integracao" data-motion-title class="mt-2 text-3xl text-foreground lg:text-4xl">
				{titulo}
			</h2>
			<p class="mx-auto mt-4 max-w-160 text-base text-muted lg:mx-0 lg:text-lg">{descricao}</p>
			<div class="mt-7 flex flex-col justify-center gap-3 md:flex-row lg:justify-start">
				<Button
					href={principal.href}
					label={principal.label}
					variant="primary"
					arrow
					animation="shine"
					class="w-full md:w-auto"
				/>
				<Button
					href={secundario.href}
					label={secundario.label}
					variant="outline"
					arrow
					animation="shine"
					class="w-full md:w-auto"
				/>
			</div>
		</div>

		<div class="relative z-10">
			<ul class="grid grid-cols-2 gap-3">
				{
					sistemas.map((sistema, indice) => (
						<li
							data-animate="scale"
							data-animate-delay={0.1 + indice * 0.08}
							class:list={[
								'rounded-small p-5 text-center sm:text-left',
								indice === 0 ? 'bg-primary' : 'border border-stroke bg-surface/70',
							]}
						>
							<p
								class:list={[
									'font-title text-sm font-bold',
									indice === 0 ? 'text-white/80' : 'text-primary',
								]}
							>
								{String(indice + 1).padStart(2, '0')}
							</p>
							<h3 class="mt-2 text-lg text-foreground">{sistema.titulo}</h3>
							<p
								class:list={['mt-1 text-sm leading-5', indice === 0 ? 'text-white' : 'text-muted']}
							>
								{sistema.texto}
							</p>
						</li>
					))
				}
			</ul>
			<p
				data-animate="fade-up"
				data-animate-delay={0.45}
				class="mt-3 flex items-center justify-center gap-2 rounded-full border border-primary/40 bg-primary/10 px-4 py-3 text-center text-sm font-semibold text-text-secondary"
			>
				<span
					class="size-2 shrink-0 rounded-full bg-primary motion-safe:animate-pulse"
					aria-hidden="true"></span>
				Uma equipe, do projeto à desmontagem
			</p>
		</div>
	</div>
</section>
