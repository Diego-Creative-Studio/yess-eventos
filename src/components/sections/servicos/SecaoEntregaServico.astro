---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import Icone from '@/components/Icon.astro'

type NomeIcone =
	| 'calendario'
	| 'estrutura'
	| 'ferramentas'
	| 'equipe'
	| 'medida'
	| 'montagem'
	| 'testes'
	| 'operacao'

interface ItemEntrega {
	icone: NomeIcone
	titulo: string
	descricao: string
}

interface Props {
	etiqueta: string
	titulo: string
	descricao: string
	itens: ItemEntrega[]
	nota: string
	imagem: ImageMetadata
	textoAlternativoImagem: string
}

const { etiqueta, titulo, descricao, itens, nota, imagem, textoAlternativoImagem } = Astro.props
---

<section class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5">
	<div
		data-animate
		class="mx-auto grid w-full overflow-hidden rounded-3xl border-2 border-stroke bg-linear-to-br from-background to-primary-soft lg:min-h-162.5 lg:max-w-345 lg:grid-cols-[1.15fr_1fr]"
	>
		<div class="p-6 lg:p-12">
			<p class="font-title text-sm font-semibold text-primary uppercase" set:html={etiqueta} />
			<h2 class="mt-2 font-title text-3xl text-foreground lg:text-4xl" set:html={titulo} />
			<p class="mt-4 max-w-160 text-base text-muted lg:text-lg" set:html={descricao} />

			<ul class="mt-7 grid gap-5"
				>{
					itens.map((item) => (
						<li class="flex items-center gap-4">
							<>
								<span class="flex size-15 shrink-0 items-center justify-center rounded-full bg-primary-soft text-white">
									<Icone name={item.icone} class="size-7" />
								</span>
								<div class="min-w-0 flex-1">
									<>
										<h3 class="font-title text-base text-foreground" set:html={item.titulo} />
										<p class="text-sm text-muted" set:html={item.descricao} />
									</>
								</div>
							</>
						</li>
					))
				}</ul
			>
			<p
				class="mt-7 border-t border-stroke pt-5 text-sm font-semibold text-text-secondary"
				set:html={nota}
			/>
		</div>

		<div class="relative min-h-96 lg:min-h-full"
			><Image
				src={imagem}
				alt={textoAlternativoImagem}
				class="l absolute inset-0 size-full object-cover lg:rounded-tl-3xl lg:rounded-bl-3xl"
			/>
		</div>
	</div>
</section>
