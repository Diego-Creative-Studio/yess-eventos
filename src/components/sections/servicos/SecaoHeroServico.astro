---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import Botao from '@/components/Button.astro'

interface Props {
	tituloDestaque: string
	titulo: string
	descricao: string
	imagem: ImageMetadata
	textoAlternativoImagem: string
	textoBotao: string
	linkBotao: string
}

const { tituloDestaque, titulo, descricao, imagem, textoAlternativoImagem, textoBotao, linkBotao } =
	Astro.props
---

<section class="bg-stroke px-3 pt-4 pb-8 md:px-8 lg:px-16 lg:pt-5 lg:pb-16">
	<div
		data-animate
		class="mx-auto grid w-full grid-cols-1 overflow-hidden rounded-hero border-2 border-stroke bg-linear-to-b from-background via-primary-soft to-violet lg:min-h-184 lg:max-w-345 lg:grid-cols-[1.1fr_1fr] lg:bg-linear-to-r"
	>
		<div
			class="flex min-w-0 items-center px-6 py-10 sm:px-10 lg:items-start lg:pt-16 lg:pr-9 lg:pb-22 lg:pl-14"
		>
			<div
				class="flex w-full max-w-197.5 flex-col items-center gap-4.5 text-center lg:h-146 lg:max-w-200 lg:items-start lg:overflow-hidden lg:text-left"
			>
				<slot name="etiqueta" />

				<h1
					class="w-full pt-2 font-title text-[2.35rem] uppercase sm:text-5xl md:max-w-5xl lg:text-6xl"
				>
					<strong class="font-extrabold" set:html={tituloDestaque} />{' '}
					<span class="font-semibold" set:html={titulo} />
				</h1>

				<p
					class="w-full font-title text-base text-foreground/80 md:max-w-147.5 md:text-lg"
					set:html={descricao}
				/>

				<div
					class="flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row lg:justify-start"
				>
					<Botao label={textoBotao} href={linkBotao} arrow class="w-full sm:w-auto" />
				</div>
			</div>
		</div>

		<div class="relative min-h-96 overflow-hidden lg:min-h-full">
			<Image
				src={imagem}
				alt={textoAlternativoImagem}
				class="absolute inset-0 size-full object-cover lg:rounded-tl-3xl lg:rounded-bl-3xl"
				loading="eager"
			/>
		</div>
	</div>
</section>
