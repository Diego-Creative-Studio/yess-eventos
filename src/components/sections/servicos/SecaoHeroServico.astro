---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import Botao from '@/components/Button.astro'
import Etiqueta from '@/components/Etiqueta.astro'

interface Props {
	etiqueta: string
	tituloDestaque: string
	titulo: string
	descricao: string
	imagem: ImageMetadata
	textoAlternativoImagem: string
	textoBotao: string
	linkBotao: string
	corFundoEtiqueta?: string
	corTextoEtiqueta?: string
	corBolinhaEtiqueta?: string
}

const {
	etiqueta,
	tituloDestaque,
	titulo,
	descricao,
	imagem,
	textoAlternativoImagem,
	textoBotao,
	linkBotao,
	corFundoEtiqueta = 'bg-violet-dark',
	corTextoEtiqueta = 'text-foreground',
	corBolinhaEtiqueta = 'bg-warm',
} = Astro.props
---

<section class="bg-stroke px-3 pt-4 pb-8 md:px-8 lg:px-16 lg:pt-5 lg:pb-16">
	<div
		data-animate
		class="mx-auto grid w-full min-w-0 grid-cols-1 overflow-hidden rounded-hero border-2 border-stroke bg-linear-to-b from-background via-violet-dark to-violet lg:min-h-184 lg:max-w-345 lg:grid-cols-[1.1fr_1fr] lg:bg-linear-to-r"
	>
		<div
			class="flex min-w-0 flex-col items-center justify-center px-6 py-12 text-center lg:items-start lg:px-10 lg:py-16 lg:text-left"
		>
			<Etiqueta
				texto={etiqueta}
				corFundo={corFundoEtiqueta}
				corTexto={corTextoEtiqueta}
				corBolinha={corBolinhaEtiqueta}
				class="self-center lg:self-start lg:text-left"
			/>

			<h1
				class="mt-6 w-full max-w-xs font-title text-4xl text-foreground uppercase md:max-w-150 md:text-5xl lg:text-6xl"
			>
				<strong class="font-extrabold" set:html={tituloDestaque} />{' '}
				<span class="font-semibold" set:html={titulo} />
			</h1>

			<p
				class="mt-5 w-full max-w-xs text-base text-foreground/80 md:max-w-147.5 md:text-lg"
				set:html={descricao}
			/>
			<Botao label={textoBotao} href={linkBotao} arrow class="mt-6 w-full max-w-xs md:w-auto" />
		</div>

		<div class="relative min-h-96 overflow-hidden lg:min-h-full">
			<Image
				src={imagem}
				alt={textoAlternativoImagem}
				class="absolute inset-0 size-full object-cover"
				loading="eager"
			/>
			<div
				class="absolute inset-0 bg-linear-to-t from-background/60 to-transparent to-45% lg:bg-linear-to-r lg:from-violet/20 lg:to-transparent lg:to-30%"
				aria-hidden="true"></div>
		</div>
	</div>
</section>
