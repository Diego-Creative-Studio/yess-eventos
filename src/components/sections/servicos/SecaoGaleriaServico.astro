---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface ItemGaleria {
	titulo: string
	descricao: string
	imagem: ImageMetadata
	textoAlternativoImagem: string
}

interface Props {
	id?: string
	etiqueta?: string
	titulo: string
	descricao: string
	itens: [ItemGaleria, ItemGaleria, ItemGaleria]
	variante?: 'background' | 'surface'
}

const { id, etiqueta, titulo, descricao, itens, variante = 'background' } = Astro.props
const fundo = variante === 'surface' ? 'bg-surface' : 'bg-background'
---

<section {id} class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5">
	<div
		data-animate
		class:list={[
			'mx-auto w-full rounded-3xl border-2 border-stroke p-6 lg:max-w-345 lg:p-10',
			fundo,
		]}
	>
		{
			etiqueta && (
				<p class="font-title text-sm font-semibold text-warm uppercase" set:html={etiqueta} />
			)
		}
		<h2
			class:list={['font-title text-3xl text-foreground lg:text-4xl', etiqueta && 'mt-2']}
			set:html={titulo}
		/>
		<p class="mt-3 max-w-210 text-base text-muted lg:text-lg" set:html={descricao} />

		<div class="mt-8 grid gap-6 lg:h-130 lg:grid-cols-[minmax(0,650fr)_minmax(0,638fr)]">
			<article
				class="group relative min-h-96 overflow-hidden rounded-3xl border-2 border-stroke lg:h-130"
			>
				<Image
					src={itens[0].imagem}
					alt={itens[0].textoAlternativoImagem}
					class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
				/>
				<div
					class="absolute inset-0 bg-linear-to-t from-background from-10% to-transparent to-55%"
					aria-hidden="true"></div>
				<div class="absolute right-7 bottom-7 left-7"
					><h3 class="font-title text-2xl text-foreground" set:html={itens[0].titulo} /><p
						class="mt-1.5 text-sm text-muted"
						set:html={itens[0].descricao}
					/></div
				>
			</article>

			<div class="grid gap-6 lg:grid-rows-2">
				{
					itens.slice(1).map((item) => (
						<article class="group relative min-h-72 overflow-hidden rounded-3xl border-2 border-stroke lg:min-h-0">
							<Image
								src={item.imagem}
								alt={item.textoAlternativoImagem}
								class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
							/>
							<div
								class="absolute inset-0 bg-linear-to-t from-background from-10% to-transparent to-65%"
								aria-hidden="true"
							/>
							<div class="absolute right-7 bottom-7 left-7">
								<>
									<h3 class="font-title text-xl text-foreground" set:html={item.titulo} />
									<p class="mt-1.5 text-sm text-muted" set:html={item.descricao} />
								</>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>
