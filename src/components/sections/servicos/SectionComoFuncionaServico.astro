---
import Button from '@/components/Button.astro'
import Icon from '@/components/Icon.astro'
import LightHalo from '@/components/LightHalo.astro'

interface Props {
	etiqueta: string
	titulo: string
	paragrafos: string[]
	tituloLocal: string
	textosLocal: string[]
	/** Resposta para quem buscou "aluguel"/"locação". */
	textoAluguel: string
	itens: string[]
	eventos: string[]
	linkOrcamento?: string
}

const {
	etiqueta,
	titulo,
	paragrafos,
	tituloLocal,
	textosLocal,
	textoAluguel,
	itens,
	eventos,
	linkOrcamento = '#canais',
} = Astro.props
---

<section class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5" aria-labelledby="como-funciona">
	<div
		class="relative mx-auto grid w-full overflow-hidden rounded-3xl border-2 border-stroke bg-linear-to-br from-background to-primary-soft lg:max-w-345 lg:grid-cols-[1.35fr_1fr]"
	>
		<LightHalo
			data-animate={false}
			class="top-0 right-0"
			color="primary"
			size="md"
			intensity="subtle"
		/>

		<div class="relative z-10 p-6 text-center md:p-10 lg:p-12 lg:text-left">
			<div data-animate="fade-left">
				<p class="text-sm font-semibold text-primary uppercase">{etiqueta}</p>
				<h2 id="como-funciona" data-motion-title class="mt-2 text-3xl text-foreground lg:text-4xl">
					{titulo}
				</h2>
				{
					paragrafos.map((texto) => (
						<p class="mx-auto mt-4 max-w-160 text-base text-muted lg:mx-0 lg:text-lg">{texto}</p>
					))
				}
			</div>

			<div
				data-animate="fade-up"
				data-animate-delay={0.15}
				class="mt-8 rounded-small border border-stroke bg-surface/70 p-5 md:p-6"
			>
				<div class="flex flex-col items-center gap-3 lg:flex-row">
					<span
						class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary-soft text-white"
					>
						<Icon name="localizacao" class="size-5" />
					</span>
					<h3 class="text-xl text-foreground">{tituloLocal}</h3>
				</div>
				{
					textosLocal.map((texto) => (
						<p class="mt-3 text-sm leading-6 text-muted md:text-base">{texto}</p>
					))
				}
			</div>

			<div
				data-animate="fade-up"
				data-animate-delay={0.25}
				class="mt-4 rounded-small border border-primary/40 bg-primary/10 p-5 md:p-6"
			>
				<p class="text-xs font-semibold tracking-wide text-primary uppercase">
					Procurando aluguel ou locação?
				</p>
				<p class="mt-2 text-sm leading-6 text-text-secondary md:text-base">{textoAluguel}</p>
			</div>
		</div>

		<aside
			class="relative z-10 flex flex-col gap-8 border-t-2 border-stroke bg-background/40 p-6 text-center md:p-10 lg:border-t-0 lg:border-l-2 lg:p-12 lg:text-left"
		>
			<div data-animate="fade-right">
				<p class="text-sm font-semibold text-primary uppercase">O que entra no projeto</p>
				<ol class="mt-4">
					{
						itens.map((item, indice) => (
							<li class="flex items-center justify-center gap-4 border-b border-stroke py-3.5 last:border-b-0 lg:justify-start">
								<span class="font-title text-sm font-bold text-primary lg:w-6 lg:shrink-0">
									{String(indice + 1).padStart(2, '0')}
								</span>
								<span class="text-foreground">{item}</span>
							</li>
						))
					}
				</ol>
			</div>

			<div data-animate="fade-right" data-animate-delay={0.1}>
				<p class="text-sm font-semibold text-primary uppercase">Eventos atendidos</p>
				<ul class="mt-4 flex flex-wrap justify-center gap-2 lg:justify-start">
					{
						eventos.map((evento) => (
							<li class="rounded-full border border-stroke bg-surface-alt px-3.5 py-2 text-sm text-foreground">
								{evento}
							</li>
						))
					}
				</ul>
			</div>

			<Button
				href={linkOrcamento}
				label="Solicitar orçamento"
				variant="primary"
				arrow
				animation="shine"
				class="mt-auto w-full"
			/>
		</aside>
	</div>
</section>
