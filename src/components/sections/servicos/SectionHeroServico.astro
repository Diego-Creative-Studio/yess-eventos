---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import Botao from '@/components/Button.astro'

interface Props {
	tituloDestaque: string
	titulo: string
	varianteTitulo?: 'padrao' | 'som-iluminacao'
	descricao: string
	imagem: ImageMetadata
	textoAlternativoImagem: string
	textoBotao: string
	linkBotao: string
}

const {
	tituloDestaque,
	titulo,
	varianteTitulo = 'padrao',
	descricao,
	imagem,
	textoAlternativoImagem,
	textoBotao,
	linkBotao,
} = Astro.props
---

<section class="bg-stroke px-3 pt-4 pb-8 md:px-8 lg:px-16 lg:pt-5 lg:pb-16">
	<div
		data-animate
		class="relative mx-auto grid w-full grid-cols-1 overflow-hidden rounded-hero border-2 border-stroke bg-linear-to-b from-background via-primary-soft to-violet lg:min-h-184 lg:max-w-345 lg:grid-cols-[1.1fr_1fr] lg:bg-linear-to-r"
	>
		<div
			class="relative isolate flex min-w-0 items-center overflow-hidden px-6 py-10 max-[359px]:px-4 md:px-10 lg:items-start lg:pt-16 lg:pr-9 lg:pb-22 lg:pl-14"
		>
			<span
				aria-hidden="true"
				class="pointer-events-none absolute -bottom-32 -left-40 h-80 w-md rounded-full bg-primary/40 blur-3xl lg:-bottom-60 lg:-left-40 lg:h-100 lg:w-80"
			></span>
			<div
				class="relative z-10 flex w-full max-w-197.5 flex-col items-center gap-4.5 text-center min-[1100px]:h-146! lg:h-151 lg:max-w-200 lg:items-start lg:overflow-hidden lg:text-left"
			>
				<slot name="etiqueta" />

				<h1
					class:list={[
						'w-full pt-2 uppercase md:max-w-5xl',
						varianteTitulo === 'som-iluminacao'
							? 'text-[2rem] max-[359px]:text-3xl min-[1420px]:text-[3.25rem]! md:text-5xl'
							: 'text-[2rem] max-[360px]:text-3xl min-[1420px]:text-6xl! md:text-5xl',
					]}
				>
					<strong class="font-extrabold" set:html={tituloDestaque} />{' '}
					<span class="font-semibold" set:html={titulo} />
				</h1>

				<p
					class="w-full text-base text-foreground/80 md:max-w-147.5 md:text-lg"
					set:html={descricao}
				/>

				<div
					class="flex w-full flex-col items-center justify-center gap-3 md:w-auto md:flex-row lg:justify-start"
				>
					<Botao label={textoBotao} href={linkBotao} arrow class="z-10 w-full md:w-auto" />
				</div>
			</div>
		</div>

		<div class="relative min-h-96 overflow-hidden lg:min-h-full">
			<Image
				src={imagem}
				alt={textoAlternativoImagem}
				class="absolute inset-0 size-full object-cover lg:rounded-tl-3xl lg:rounded-bl-3xl"
				loading="eager"
			/>
		</div>
	</div>
</section>
