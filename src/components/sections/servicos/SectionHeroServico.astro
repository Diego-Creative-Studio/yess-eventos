---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import Botao from '@/components/Button.astro'
import Icon from '@/components/Icon.astro'
import LightHalo from '@/components/LightHalo.astro'

interface Props {
	tituloDestaque: string
	titulo: string
	varianteTitulo?: 'padrao' | 'som-iluminacao' | 'tvs-monitores'
	/** Mostra o título em destaque como se estivesse aceso num painel de LED. */
	painelLed?: boolean
	/** Feixes de luz de moving head varrendo o hero, com o título aceso. */
	showDeLuz?: boolean
	/** Mostra a imagem num videowall 2×2 de TVs que ligam em sequência. */
	videowall?: boolean
	/** Diagrama de sinal ligando LED, som, luz e TVs a uma operação central. */
	mapaSinal?: boolean
	descricao: string
	imagem: ImageMetadata
	textoAlternativoImagem: string
	textoBotao: string
	linkBotao: string
	videoMp4?: string
	videoWebm?: string
}

const {
	tituloDestaque,
	titulo,
	varianteTitulo = 'padrao',
	painelLed = false,
	showDeLuz = false,
	videowall = false,
	mapaSinal = false,
	descricao,
	imagem,
	textoAlternativoImagem,
	textoBotao,
	linkBotao,
	videoMp4,
	videoWebm,
} = Astro.props

const temVideo = Boolean(videoMp4 || videoWebm)

/** Pontos do mapa de sinal, em % da área da imagem. */
const pontosSinal = [
	{ rotulo: 'Painel de LED', x: 22, y: 22 },
	{ rotulo: 'Som', x: 78, y: 20 },
	{ rotulo: 'Iluminação', x: 20, y: 78 },
	{ rotulo: 'TVs', x: 80, y: 76 },
]
const centroSinal = { x: 50, y: 50 }
const tituloComplementar = titulo.replace(/^\s*<br\s*\/?\s*>\s*/i, '')
---

<section class="px-3 pt-4 pb-8 md:px-8 lg:px-16 lg:pt-5 lg:pb-16">
	<div
		data-service-hero={temVideo || undefined}
		class:list={[
			'relative mx-auto grid w-full grid-cols-1 overflow-hidden rounded-hero bg-linear-to-b from-background via-primary-soft to-violet lg:max-w-345 lg:grid-cols-[1.1fr_1fr] lg:bg-linear-to-r',
			varianteTitulo === 'tvs-monitores' ? 'lg:min-h-170' : 'lg:min-h-184',
			painelLed && 'led-panel',
			(showDeLuz || videowall || mapaSinal) && 'light-stage',
		]}
		data-light-hero={showDeLuz || undefined}
	>
		<div
			data-service-content={temVideo || undefined}
			class="relative isolate z-30 flex min-w-0 items-center overflow-hidden px-6 py-10 max-[359px]:px-4 md:px-10 lg:items-start lg:pt-16 lg:pr-9 lg:pb-22 lg:pl-14"
		>
			{
				!painelLed && !showDeLuz && !videowall && !mapaSinal && (
					<LightHalo
						data-animate={false}
						class="bottom-10 left-16"
						color="primary"
						size="lg"
						intensity="strong"
					/>
				)
			}
			<div
				data-service-copy
				class:list={[
					'relative z-10 flex w-full max-w-197.5 flex-col items-center gap-4.5 text-center lg:max-w-200 lg:items-start lg:overflow-hidden lg:text-left',
					varianteTitulo === 'tvs-monitores' ? 'lg:h-auto' : 'lg:min-h-146',
				]}
			>
				<div class:list={[painelLed && 'led-panel__fine']}>
					<slot name="etiqueta" />
				</div>

				<!-- No painel de LED, a animação própria (ligar) substitui a de linhas. -->
				<h1
					data-motion-title={!painelLed || undefined}
					data-motion-immediate={!painelLed || undefined}
					class:list={[
						'w-full pt-2 uppercase md:max-w-5xl',
						showDeLuz && 'light-title',
						varianteTitulo === 'som-iluminacao' || varianteTitulo === 'tvs-monitores'
							? 'text-[2rem] leading-[1.08] max-[359px]:text-[1.75rem] min-[1420px]:text-[3.25rem]! md:text-5xl'
							: 'text-[2rem] leading-[1.08] max-[359px]:text-[1.75rem] min-[1420px]:text-6xl! md:text-5xl',
					]}
				>
					{
						painelLed ? (
							<span class="led-panel__glow block">
								<span class="led-panel__text block">
									<strong class="block font-extrabold" set:html={tituloDestaque} />
									<span
										class="led-panel__accent mt-2 block font-semibold"
										set:html={tituloComplementar}
									/>
								</span>
							</span>
						) : (
							<>
								<strong class="block font-extrabold" set:html={tituloDestaque} />
								<span class="mt-2 block font-semibold" set:html={tituloComplementar} />
							</>
						)
					}
				</h1>

				<p
					class:list={[
						'w-full text-base text-foreground/80 md:max-w-147.5 md:text-lg',
						painelLed && 'led-panel__fine led-panel__body',
					]}
					set:html={descricao}
				/>

				<div
					class:list={[
						'flex w-full flex-col items-center justify-center gap-3 md:w-auto md:flex-row lg:justify-start',
						painelLed && 'led-panel__fine',
					]}
				>
					<Botao
						label={textoBotao}
						href={linkBotao}
						arrow
						class="z-10 w-full md:w-auto"
						animation="shine"
					/>
				</div>
			</div>
		</div>

		<div
			data-service-media={temVideo || undefined}
			class:list={[
				'relative min-h-96 overflow-hidden lg:min-h-full',
				temVideo &&
					'group cursor-pointer lg:absolute lg:inset-y-0 lg:right-0 lg:z-20 lg:w-[47.62%]',
			]}
		>
			{
				temVideo && (
					<video
						data-service-video
						muted
						playsinline
						loop
						preload="metadata"
						poster={imagem.src}
						class:list={[
							'pointer-events-none absolute inset-0 size-full object-cover',
							!painelLed && !videowall && 'lg:rounded-l-3xl',
						]}
					>
						{videoWebm && <source src={videoWebm} type="video/webm" />}
						{videoMp4 && <source src={videoMp4} type="video/mp4" />}
					</video>
				)
			}
			<Image
				data-service-poster={temVideo || undefined}
				src={imagem}
				alt={textoAlternativoImagem}
				class:list={[
					'pointer-events-none absolute inset-0 size-full object-cover',
					!painelLed && !videowall && 'lg:rounded-l-3xl',
				]}
				loading="eager"
			/>
			<!-- Grade de pixels por cima da imagem, como se ela passasse no painel. -->
			{
				painelLed && (
					<span aria-hidden="true" class="led-pixels pointer-events-none absolute inset-0" />
				)
			}
			<!-- Mapa de sinal: cada sistema ligado à operação central por um "cabo" com sinal correndo. -->
			{
				mapaSinal && (
					<div class="sig-map pointer-events-none absolute inset-0 z-5">
						<svg
							class="absolute inset-0 size-full"
							viewBox="0 0 100 100"
							preserveAspectRatio="none"
							aria-hidden="true"
						>
							{pontosSinal.map((ponto, indice) => (
								<g class={`sig-link sig-link--${indice + 1}`} style={`--i: ${indice}`}>
									<line
										class="sig-line"
										x1={ponto.x}
										y1={ponto.y}
										x2={centroSinal.x}
										y2={centroSinal.y}
										pathLength="100"
									/>
									<line
										class="sig-pulse"
										x1={ponto.x}
										y1={ponto.y}
										x2={centroSinal.x}
										y2={centroSinal.y}
										pathLength="100"
									/>
								</g>
							))}
						</svg>
						<span
							class="sig-hub absolute flex -translate-1/2 flex-col items-center justify-center rounded-full font-title text-white"
							style={`left: ${centroSinal.x}%; top: ${centroSinal.y}%`}
						>
							<span class="text-sm font-extrabold tracking-wide">YESS</span>
							<span class="text-[0.6rem] tracking-widest text-white/70 uppercase">Operação</span>
						</span>
						<ul aria-label="Sistemas integrados">
							{pontosSinal.map((ponto, indice) => (
								<li
									class={`sig-node sig-node--${indice + 1} pointer-events-auto absolute flex -translate-1/2 items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-semibold whitespace-nowrap backdrop-blur-sm md:text-sm`}
									style={`left: ${ponto.x}%; top: ${ponto.y}%; --i: ${indice}`}
								>
									<span class="sig-dot size-2 shrink-0 rounded-full" aria-hidden="true" />
									{ponto.rotulo}
									<span class="sig-check text-primary" aria-hidden="true">✓</span>
								</li>
							))}
						</ul>
					</div>
				)
			}
			<!-- Videowall: molduras das 4 TVs por cima da imagem, que continua de uma tela para outra. -->
			{
				videowall && (
					<span
						aria-hidden="true"
						class="tv-wall pointer-events-none absolute inset-0 z-5 grid grid-cols-2 grid-rows-2"
					>
						<span class="tv-tile" />
						<span class="tv-tile" />
						<span class="tv-tile" />
						<span class="tv-tile" />
						<span class="tv-glare" />
					</span>
				)
			}
			{
				temVideo && (
					<button
						data-service-video-control
						type="button"
						aria-label="Reproduzir vídeo"
						class="absolute right-5 bottom-5 z-10 inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/30 bg-background/75 px-4 py-3 font-title text-sm font-semibold text-white shadow-lg backdrop-blur-md transition-colors hover:border-primary hover:bg-background"
					>
						<span data-service-video-label>Ver vídeo</span>
						<span data-service-play-icon class="flex items-center">
							<Icon name="play" class="size-4" />
						</span>
						<span data-service-pause-icon class="hidden items-center gap-1" aria-hidden="true">
							<span class="h-4 w-1 rounded-full bg-current" />
							<span class="h-4 w-1 rounded-full bg-current" />
						</span>
					</button>
				)
			}
		</div>

		{
			showDeLuz && (
				<div aria-hidden="true" class="pointer-events-none absolute inset-0 z-40 overflow-hidden">
					<span class="light-fog" />
					<span class="light-rig left-[12%]">
						<span class="light-lens light-lens--1" />
						<span class="light-beam light-beam--1" />
					</span>
					<span class="light-rig left-[40%]">
						<span class="light-lens light-lens--2" />
						<span class="light-beam light-beam--2" />
					</span>
					<span class="light-rig left-[66%] max-lg:hidden">
						<span class="light-lens light-lens--3" />
						<span class="light-beam light-beam--3" />
					</span>
					<span data-light-follow class="light-rig light-rig--follow left-[88%]">
						<span class="light-lens light-lens--4" />
						<span class="light-beam light-beam--4" />
					</span>
				</div>
			)
		}
	</div>
</section>

<style>
	/* Mapa de sinal: imagem escurecida para o diagrama aparecer. */
	.sig-map {
		background: radial-gradient(ellipse at 50% 50%, rgb(3 5 9 / 0.35), rgb(3 5 9 / 0.7));
	}

	.sig-line {
		stroke: rgb(156 195 255 / 0.55);
		stroke-width: 0.3;
		stroke-dasharray: 100;
		stroke-dashoffset: 0;
	}

	.sig-pulse {
		stroke: #7fb0ff;
		stroke-width: 0.7;
		stroke-linecap: round;
		stroke-dasharray: 6 94;
		opacity: 0;
		filter: drop-shadow(0 0 4px #2678ff);
	}

	.sig-hub {
		width: 5.5rem;
		height: 5.5rem;
		background: radial-gradient(circle, #1b4fd1, #0a1d4a);
		border: 1px solid rgb(127 176 255 / 0.6);
		box-shadow:
			0 0 0 6px rgb(38 120 255 / 0.12),
			0 0 40px rgb(38 120 255 / 0.55);
	}

	.sig-node {
		color: #eaf2ff;
		border-color: rgb(127 176 255 / 0.5);
		background: rgb(5 8 14 / 0.75);
		transition:
			border-color 0.25s,
			box-shadow 0.25s;
	}

	.sig-dot {
		background: #2678ff;
		box-shadow: 0 0 8px #2678ff;
	}

	/* Passar o mouse num sistema destaca o cabo dele. */
	.sig-node:hover {
		border-color: #7fb0ff;
		box-shadow: 0 0 18px rgb(38 120 255 / 0.55);
	}

	.sig-map:has(.sig-node--1:hover) .sig-link--1 .sig-line,
	.sig-map:has(.sig-node--2:hover) .sig-link--2 .sig-line,
	.sig-map:has(.sig-node--3:hover) .sig-link--3 .sig-line,
	.sig-map:has(.sig-node--4:hover) .sig-link--4 .sig-line {
		stroke: #9cc3ff;
		stroke-width: 0.5;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* Cada cabo se desenha até o centro, um depois do outro. */
		.sig-line {
			animation: sig-draw 0.7s ease-out both;
			animation-delay: calc(0.3s + var(--i) * 0.35s);
		}

		/* O sistema acende quando o sinal chega. */
		.sig-node {
			animation: sig-node-on 0.5s ease-out both;
			animation-delay: calc(0.85s + var(--i) * 0.35s);
		}

		.sig-check {
			animation: sig-check 0.4s ease-out both;
			animation-delay: calc(1s + var(--i) * 0.35s);
		}

		/* Depois, o sinal fica correndo pelos cabos. */
		.sig-pulse {
			opacity: 1;
			animation: sig-pulse 2.4s linear infinite;
			animation-delay: calc(2.2s + var(--i) * 0.6s);
			stroke-dashoffset: 100;
		}

		.sig-hub {
			animation: sig-hub 3s ease-in-out 2s infinite;
		}
	}

	@keyframes sig-draw {
		from {
			stroke-dashoffset: 100;
		}
	}

	@keyframes sig-node-on {
		from {
			opacity: 0.25;
			border-color: rgb(127 176 255 / 0.15);
		}
		60% {
			box-shadow: 0 0 22px rgb(38 120 255 / 0.7);
		}
	}

	@keyframes sig-check {
		from {
			opacity: 0;
			transform: scale(0.4);
		}
	}

	@keyframes sig-pulse {
		from {
			stroke-dashoffset: 100;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes sig-hub {
		50% {
			box-shadow:
				0 0 0 12px rgb(38 120 255 / 0.06),
				0 0 56px rgb(38 120 255 / 0.7);
		}
	}

	/* Videowall: cada TV tem moldura fina; as emendas pretas dividem a imagem. */
	.tv-wall {
		--tv-gap: 6px;
		--tv-radius: 10px;
		/* Canto das TVs da borda acompanha o arredondamento do hero. */
		--tv-radius-edge: calc(var(--radius-hero) - var(--tv-gap));
		overflow: hidden;
		gap: var(--tv-gap);
		padding: var(--tv-gap);
		/* Moldura e emendas pretas, para não vazar imagem onde as TVs se encontram. */
		background:
			linear-gradient(#07090d, #07090d) center / var(--tv-gap) 100% no-repeat,
			linear-gradient(#07090d, #07090d) center / 100% var(--tv-gap) no-repeat;
		box-shadow: inset 0 0 0 var(--tv-gap) #07090d;
	}

	/* A sombra preta em volta preenche as emendas e os cantos, deixando a TV arredondada. */
	.tv-tile {
		position: relative;
		overflow: hidden;
		border-radius: var(--tv-radius);
		box-shadow:
			0 0 0 var(--tv-gap) #07090d,
			inset 0 0 0 1px rgb(255 255 255 / 0.1),
			inset 0 0 24px rgb(0 0 0 / 0.45);
	}

	/* No celular o videowall fica embaixo: arredonda os cantos de baixo. */
	.tv-tile:nth-child(3) {
		border-bottom-left-radius: var(--tv-radius-edge);
	}

	.tv-tile:nth-child(4) {
		border-bottom-right-radius: var(--tv-radius-edge);
	}

	/* Abertura da tela a partir do meio (0% = apagada, 50% = toda aberta). */
	@property --tv-open {
		syntax: '<percentage>';
		inherits: false;
		initial-value: 50%;
	}

	/* Tela apagada que se abre a partir do meio, como uma TV ligando. */
	.tv-tile::before {
		content: '';
		position: absolute;
		inset: 0;
		background: #020305;
		--tv-mask: linear-gradient(
			to bottom,
			#000 calc(50% - var(--tv-open)),
			transparent calc(50% - var(--tv-open)),
			transparent calc(50% + var(--tv-open)),
			#000 calc(50% + var(--tv-open))
		);
		-webkit-mask-image: var(--tv-mask);
		mask-image: var(--tv-mask);
	}

	/* Linha branca que aparece no meio antes da imagem abrir. */
	.tv-tile::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 2px;
		margin-top: -1px;
		background: #e8f0ff;
		box-shadow: 0 0 12px 2px rgb(156 195 255 / 0.8);
		opacity: 0;
	}

	/* Reflexo do vidro passando pelas telas. */
	.tv-glare {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			115deg,
			transparent 35%,
			rgb(255 255 255 / 0.1) 45%,
			rgb(255 255 255 / 0.03) 52%,
			transparent 60%
		);
		background-size: 250% 100%;
		background-position: 120% 0;
		mix-blend-mode: screen;
	}

	/* No desktop o videowall fica à direita: arredonda os cantos da direita. */
	@media (min-width: 1024px) {
		.tv-wall {
			--tv-gap: 8px;
		}

		.tv-tile:nth-child(3) {
			border-bottom-left-radius: var(--tv-radius);
		}

		.tv-tile:nth-child(2) {
			border-top-right-radius: var(--tv-radius-edge);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.tv-tile::before {
			animation: tv-cover 1.1s cubic-bezier(0.65, 0, 0.35, 1) both;
		}

		.tv-tile::after {
			animation: tv-line 1.1s ease-out both;
		}

		.tv-tile:nth-child(2)::before,
		.tv-tile:nth-child(2)::after {
			animation-delay: 0.18s;
		}

		.tv-tile:nth-child(3)::before,
		.tv-tile:nth-child(3)::after {
			animation-delay: 0.36s;
		}

		.tv-tile:nth-child(4)::before,
		.tv-tile:nth-child(4)::after {
			animation-delay: 0.54s;
		}

		.tv-glare {
			animation: tv-glare 8s ease-in-out 1.8s infinite;
		}
	}

	@keyframes tv-cover {
		0%,
		35% {
			--tv-open: 0%;
		}
		100% {
			--tv-open: 50%;
		}
	}

	@keyframes tv-line {
		0% {
			opacity: 0;
			transform: scaleX(0);
		}
		25% {
			opacity: 1;
			transform: scaleX(1);
		}
		45% {
			opacity: 1;
		}
		70%,
		100% {
			opacity: 0;
			transform: scaleX(1);
		}
	}

	@keyframes tv-glare {
		0% {
			background-position: 120% 0;
		}
		35%,
		100% {
			background-position: -20% 0;
		}
	}

	/* Palco escuro: a luz só aparece de verdade no preto. */
	.light-stage {
		background: radial-gradient(ellipse at 50% 0%, #0c1424 0%, #05070c 55%, #030408 100%);
	}

	/* Lente do moving head, de onde o feixe sai. */
	.light-lens {
		position: absolute;
		top: 4%;
		left: -0.6rem;
		z-index: 1;
		width: 1.2rem;
		height: 1.2rem;
		border-radius: 999px;
		background: radial-gradient(circle, #fff 0%, var(--beam) 45%, transparent 72%);
		box-shadow: 0 0 24px 6px var(--beam);
		opacity: 0.85;
	}

	/* Fumaça no chão, que se move devagar e deixa os feixes visíveis. */
	.light-fog {
		position: absolute;
		inset: auto -20% 0;
		height: 55%;
		background:
			radial-gradient(ellipse 40% 55% at 25% 90%, rgb(170 190 230 / 0.14), transparent 70%),
			radial-gradient(ellipse 35% 45% at 70% 100%, rgb(150 160 230 / 0.12), transparent 70%),
			radial-gradient(ellipse 50% 40% at 50% 100%, rgb(120 160 255 / 0.1), transparent 75%);
		filter: blur(18px);
		mix-blend-mode: screen;
	}

	/* Show de luz: cada feixe sai do topo, como um moving head, e varre a cena. */
	.light-rig {
		position: absolute;
		top: -4%;
		width: 0;
		height: 125%;
		transform-origin: 50% 0;
		transform: rotate(var(--follow, 14deg));
	}

	.light-rig--follow {
		transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.light-beam {
		position: absolute;
		top: 0;
		left: -8rem;
		width: 16rem;
		height: 100%;
		transform-origin: 50% 0;
		transform: rotate(var(--from));
		filter: blur(6px);
		opacity: var(--alpha, 0.36);
		mix-blend-mode: screen;
		will-change: transform;
	}

	/* O cone fica no pseudo-elemento para o desfoque suavizar as bordas dele. */
	.light-beam::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, var(--beam) 0%, transparent 78%);
		clip-path: polygon(47% 0, 53% 0, 100% 100%, 0 100%);
	}

	/* Reflexo onde o feixe bate no chão. */
	.light-beam::after {
		content: '';
		position: absolute;
		top: calc(80% - 2.5rem);
		left: 10%;
		width: 80%;
		height: 5rem;
		border-radius: 50%;
		background: radial-gradient(ellipse, var(--beam) 0%, transparent 70%);
		opacity: 0.55;
	}

	@media (min-width: 1024px) {
		.light-beam {
			left: -13rem;
			width: 26rem;
		}
	}

	.light-lens--1,
	.light-beam--1 {
		--beam: #2678ff;
		--from: -22deg;
		--to: 16deg;
		--speed: 9s;
	}

	.light-lens--2,
	.light-beam--2 {
		--beam: #8b5cf6;
		--from: 20deg;
		--to: -16deg;
		--speed: 11s;
	}

	.light-lens--3,
	.light-beam--3 {
		--beam: #f58714;
		--from: -12deg;
		--to: 24deg;
		--speed: 13s;
		--alpha: 0.2;
	}

	/* O quarto feixe não varre sozinho: segue o cursor no desktop. */
	.light-lens--4,
	.light-beam--4 {
		--beam: #9cc3ff;
		--from: 0deg;
		--alpha: 0.26;
	}

	.light-rig:not(.light-rig--follow) {
		transform: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.light-beam:not(.light-beam--4) {
			animation: beam-sweep var(--speed) ease-in-out infinite alternate;
		}

		.light-fog {
			animation: fog-drift 24s ease-in-out infinite alternate;
		}

		.light-lens {
			animation: lens-flicker 3s ease-in-out infinite alternate;
		}

		/* O título acende quando a luz passa por ele. */
		.light-title {
			animation: title-lit 9s ease-in-out infinite;
		}
	}

	@keyframes fog-drift {
		to {
			transform: translateX(12%);
		}
	}

	@keyframes lens-flicker {
		to {
			opacity: 0.6;
		}
	}

	@keyframes beam-sweep {
		from {
			transform: rotate(var(--from));
		}
		to {
			transform: rotate(var(--to));
		}
	}

	@keyframes title-lit {
		0%,
		30%,
		70%,
		100% {
			filter: drop-shadow(0 0 0 rgb(38 120 255 / 0));
		}
		45%,
		55% {
			filter: drop-shadow(0 0 16px rgb(120 175 255 / 0.65));
		}
	}

	/* Painel de LED: fundo com os pixels apagados, texto aceso em pontos e brilho. */
	.led-panel {
		--led-pitch: 3px;
		position: relative;
		overflow: hidden;
		/* Moldura grossa do gabinete, como num painel de LED de verdade. */
		border: 10px solid #10141b;
		border-radius: 1.75rem;
		background-color: #020408;
		background-image:
			/* Emendas dos módulos do painel. */
			linear-gradient(to right, rgb(255 255 255 / 0.045) 1px, transparent 1px),
			linear-gradient(to bottom, rgb(255 255 255 / 0.045) 1px, transparent 1px),
			/* LEDs apagados. */ radial-gradient(circle, rgb(255 255 255 / 0.07) 0.6px, transparent 0.9px);
		background-size:
			25% 100%,
			100% 25%,
			var(--led-pitch) var(--led-pitch);
		box-shadow:
			/* Borda externa e interna da moldura. */
			0 0 0 1px rgb(255 255 255 / 0.1),
			inset 0 0 0 1px rgb(0 0 0 / 0.9),
			/* Sombra da tela e luz que ela projeta. */ inset 0 0 40px rgb(0 0 0 / 0.7),
			0 30px 60px -24px rgb(0 0 0 / 0.9),
			0 0 70px -12px rgb(38 120 255 / 0.5);
	}

	@media (min-width: 768px) {
		.led-panel {
			--led-pitch: 4px;
			border-width: 14px;
		}
	}

	.led-panel__glow {
		filter: drop-shadow(0 0 6px rgb(120 175 255 / 0.8)) drop-shadow(0 0 18px rgb(38 120 255 / 0.5));
	}

	/* Segunda linha em azul, como um texto de destaque no painel. */
	.led-panel__accent {
		color: #7fb0ff;
	}

	.led-panel__text {
		color: #eaf2ff;
		-webkit-mask-image: radial-gradient(circle, #000 52%, transparent 58%);
		mask-image: radial-gradient(circle, #000 52%, transparent 58%);
		-webkit-mask-size: var(--led-pitch) var(--led-pitch);
		mask-size: var(--led-pitch) var(--led-pitch);
	}

	/* Textos menores: pontos mais finos para continuar legíveis. */
	.led-panel__fine {
		--led-pitch: 2px;
		-webkit-mask-image: radial-gradient(circle, #000 62%, transparent 72%);
		mask-image: radial-gradient(circle, #000 62%, transparent 72%);
		-webkit-mask-size: var(--led-pitch) var(--led-pitch);
		mask-size: var(--led-pitch) var(--led-pitch);
	}

	.led-panel__body {
		color: #d6e4ff;
		filter: drop-shadow(0 0 6px rgb(38 120 255 / 0.6));
	}

	.led-pixels {
		background-image: radial-gradient(circle, transparent 45%, rgb(0 0 0 / 0.55) 80%);
		background-size: var(--led-pitch) var(--led-pitch);
	}

	/* Faixa de atualização que percorre o painel. */
	.led-panel::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(to bottom, transparent, rgb(255 255 255 / 0.07), transparent);
		background-size: 100% 40%;
		background-repeat: no-repeat;
		background-position: 0 -60%;
		z-index: 40;
	}

	@media (prefers-reduced-motion: no-preference) {
		.led-panel::after {
			animation: led-refresh 5s linear infinite;
		}

		.led-panel__text,
		.led-panel__fine {
			animation: led-power-on 1.4s steps(1, end) 0.2s both;
		}
	}

	@keyframes led-refresh {
		to {
			background-position: 0 160%;
		}
	}

	@keyframes led-power-on {
		0% {
			opacity: 0;
		}
		20% {
			opacity: 0.6;
		}
		30% {
			opacity: 0.1;
		}
		45% {
			opacity: 1;
		}
		55% {
			opacity: 0.4;
		}
		70%,
		100% {
			opacity: 1;
		}
	}
</style>

<script>
	// Show de luz: o feixe seguidor aponta para o cursor (só desktop com mouse).
	document.querySelectorAll<HTMLElement>('[data-light-hero]').forEach((hero) => {
		const rig = hero.querySelector<HTMLElement>('[data-light-follow]')
		const pointer = window.matchMedia('(hover: hover) and (pointer: fine)')
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
		if (!rig) return

		hero.addEventListener('pointermove', (event) => {
			if (!pointer.matches || reduceMotion.matches) return
			const origin = rig.getBoundingClientRect()
			const angle =
				-Math.atan2(event.clientX - origin.left, event.clientY - origin.top) * (180 / Math.PI)
			rig.style.setProperty('--follow', `${Math.max(-60, Math.min(60, angle))}deg`)
		})
		hero.addEventListener('pointerleave', () => rig.style.removeProperty('--follow'))
	})
</script>

<script>
	import { gsap } from 'gsap'

	document.querySelectorAll<HTMLElement>('[data-service-hero]').forEach((hero) => {
		const media = hero.querySelector<HTMLElement>('[data-service-media]')
		const content = hero.querySelector<HTMLElement>('[data-service-content]')
		const copy = hero.querySelector<HTMLElement>('[data-service-copy]')
		const video = hero.querySelector<HTMLVideoElement>('[data-service-video]')
		const poster = hero.querySelector<HTMLElement>('[data-service-poster]')
		const control = hero.querySelector<HTMLButtonElement>('[data-service-video-control]')
		const label = hero.querySelector<HTMLElement>('[data-service-video-label]')
		const playIcon = hero.querySelector<HTMLElement>('[data-service-play-icon]')
		const pauseIcon = hero.querySelector<HTMLElement>('[data-service-pause-icon]')
		const desktopHover = window.matchMedia('(min-width: 1024px) and (hover: hover)')
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

		if (
			!media ||
			!content ||
			!copy ||
			!video ||
			!poster ||
			!control ||
			!label ||
			!playIcon ||
			!pauseIcon
		)
			return

		let playing = false
		let interactionVersion = 0
		let expansionTween: gsap.core.Tween | undefined
		const expansionTimeline = gsap
			.timeline({ paused: true, defaults: { ease: 'power3.inOut' } })
			.to(media, { width: '100%', duration: reduceMotion.matches ? 0 : 0.85 }, 0)
			.to(
				copy,
				{
					opacity: 0,
					x: -12,
					duration: reduceMotion.matches ? 0 : 0.35,
				},
				0.1,
			)

		const updateControl = (state: 'play' | 'pause' | 'continue') => {
			const showPause = state === 'pause'
			label.textContent =
				state === 'pause' ? 'Pausar vídeo' : state === 'continue' ? 'Continuar vídeo' : 'Ver vídeo'
			control.setAttribute(
				'aria-label',
				state === 'pause'
					? 'Pausar vídeo'
					: state === 'continue'
						? 'Continuar vídeo'
						: 'Reproduzir vídeo',
			)
			playIcon.classList.toggle('hidden', showPause)
			playIcon.classList.toggle('flex', !showPause)
			pauseIcon.classList.toggle('hidden', !showPause)
			pauseIcon.classList.toggle('flex', showPause)
		}

		const showVideo = async () => {
			const currentInteraction = ++interactionVersion

			try {
				await video.play()
			} catch {
				return
			}

			if (currentInteraction !== interactionVersion) {
				video.pause()
				return
			}

			playing = true
			updateControl('pause')
			gsap.killTweensOf([poster, control])
			gsap.to(poster, {
				autoAlpha: 0,
				duration: reduceMotion.matches ? 0 : 0.45,
				ease: 'power2.out',
			})

			if (desktopHover.matches) {
				expansionTween?.kill()
				expansionTween = expansionTimeline.tweenTo(expansionTimeline.duration(), {
					duration: reduceMotion.matches ? 0 : 0.85,
					ease: 'power3.inOut',
				})
			}
		}

		const pauseVideo = () => {
			interactionVersion += 1
			video.pause()
			playing = false
			updateControl('continue')
		}

		const hideVideo = () => {
			interactionVersion += 1
			video.pause()
			playing = false
			updateControl('play')
			gsap.killTweensOf([poster, control])
			gsap.to(poster, {
				autoAlpha: 1,
				duration: reduceMotion.matches ? 0 : 0.4,
				ease: 'power2.out',
			})

			if (desktopHover.matches) {
				expansionTween?.kill()
				expansionTween = expansionTimeline.tweenTo(0, {
					duration: reduceMotion.matches ? 0 : 0.65,
					ease: 'power3.inOut',
				})
			}
		}

		media.addEventListener('pointerenter', () => {
			if (desktopHover.matches) void showVideo()
		})
		hero.addEventListener('pointerleave', () => {
			if (desktopHover.matches) hideVideo()
		})
		control.addEventListener('click', () => {
			if (playing) pauseVideo()
			else void showVideo()
		})

		desktopHover.addEventListener('change', (event) => {
			if (event.matches) return

			interactionVersion += 1
			video.pause()
			playing = false
			expansionTween?.kill()
			expansionTimeline.pause(0)
			gsap.set([media, copy], { clearProps: 'width,opacity,transform' })
			gsap.set(poster, { clearProps: 'opacity,visibility' })
			updateControl('play')
		})

		document.addEventListener('visibilitychange', () => {
			if (document.hidden && playing) hideVideo()
		})
	})
</script>
