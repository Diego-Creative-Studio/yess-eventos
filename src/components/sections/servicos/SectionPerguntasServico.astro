---
interface Pergunta {
	pergunta: string
	resposta: string
}

interface Props {
	titulo: string
	perguntas: [Pergunta, Pergunta, Pergunta, Pergunta]
}

const { titulo, perguntas } = Astro.props
const fundos = ['bg-primary', 'bg-primary-soft', 'bg-stroke', 'bg-surface']
---

<section class="px-3 py-8 md:px-8 lg:px-16 lg:pt-5 lg:pb-7.5">
	<div
		class="mx-auto w-full rounded-3xl bg-linear-to-br from-background to-primary-soft p-6 lg:max-w-345 lg:p-10"
	>
		<h2 data-animate="fade-up" class="text-3xl text-foreground lg:text-4xl" set:html={titulo} />
		<div class="mt-8 grid gap-4 md:grid-cols-2"
			>{
				perguntas.map((item, indice) => (
					<article
						data-animate="scale"
						data-animate-delay={0.1 + indice * 0.08}
						class:list={['rounded-small p-6', fundos[indice]]}
					>
						<>
							<h3 class="text-base text-foreground lg:text-xl" set:html={item.pergunta} />
							<p
								class:list={[
									'mt-2',
									indice === 0 ? 'text-white text-shadow-sm' : 'text-foreground/75',
								]}
								set:html={item.resposta}
							/>
						</>
					</article>
				))
			}</div
		>
	</div>
</section>
