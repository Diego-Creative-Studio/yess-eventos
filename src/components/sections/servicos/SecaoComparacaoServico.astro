---
interface OpcaoComparacao {
	codigo: string
	etiqueta: string
	titulo: string
	descricao: string
	itens: string[]
}

interface Props {
	etiqueta: string
	titulo: string
	etiquetaOrientacao: string
	descricaoOrientacao: string
	opcaoClara: OpcaoComparacao
	opcaoDestaque: OpcaoComparacao
	nota: string
	resumo: string
}

const {
	etiqueta,
	titulo,
	etiquetaOrientacao,
	descricaoOrientacao,
	opcaoClara,
	opcaoDestaque,
	nota,
	resumo,
} = Astro.props
---

<section class="px-3 py-8 md:px-8 lg:px-16 lg:py-0">
	<div
		data-animate
		class="mx-auto w-full rounded-3xl border-2 border-stroke bg-background p-6 lg:max-w-345 lg:p-10"
	>
		<header class="grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-end">
			<div>
				<p class="font-title text-sm font-semibold text-primary uppercase" set:html={etiqueta} />
				<h2
					class="mt-2 max-w-175 font-title text-3xl text-foreground lg:text-4xl"
					set:html={titulo}
				/>
			</div>
			<div>
				<p
					class="font-title text-sm font-semibold text-primary uppercase"
					set:html={etiquetaOrientacao}
				/>
				<p class="mt-2 text-base text-muted lg:text-lg" set:html={descricaoOrientacao} />
			</div>
		</header>

		<div class="mt-8 grid gap-6 xl:grid-cols-[2fr_3fr]">
			<article class="rounded-3xl bg-white p-6 text-background lg:p-8">
				<div class="flex items-start justify-between gap-4"
					><p class="font-title text-6xl font-semibold text-warm">{opcaoClara.codigo}</p><p
						class="font-title text-xs font-semibold uppercase"
						set:html={opcaoClara.etiqueta}
					/></div
				>
				<h3 class="mt-6 font-title text-2xl" set:html={opcaoClara.titulo} />
				<p class="mt-3 text-sm text-background/70" set:html={opcaoClara.descricao} />
				<ol class="mt-7 border-t border-background/10 text-sm"
					>{
						opcaoClara.itens.map((item, indice) => (
							<li class="flex gap-4 border-b border-background/10 py-4 last:border-0">
								<>
									<strong>{String(indice + 1).padStart(2, '0')}</strong>
									<span set:html={item} />
								</>
							</li>
						))
					}</ol
				>
			</article>

			<article class="rounded-3xl bg-primary p-6 text-foreground lg:p-8">
				<div class="flex items-start justify-between gap-4"
					><p class="font-title text-6xl font-semibold">{opcaoDestaque.codigo}</p><p
						class="font-title text-xs font-semibold uppercase"
						set:html={opcaoDestaque.etiqueta}
					/></div
				>
				<h3 class="mt-6 font-title text-2xl" set:html={opcaoDestaque.titulo} />
				<p class="mt-3 text-sm text-foreground/75" set:html={opcaoDestaque.descricao} />
				<ol class="mt-7 border-t border-white/20 text-sm"
					>{
						opcaoDestaque.itens.map((item, indice) => (
							<li class="flex gap-4 border-b border-white/20 py-4 last:border-0">
								<>
									<strong>{String(indice + 1).padStart(2, '0')}</strong>
									<span set:html={item} />
								</>
							</li>
						))
					}</ol
				>
			</article>
		</div>

		<div
			class="mt-6 flex flex-col gap-2 text-xs text-muted md:flex-row md:items-center md:justify-between"
			><p set:html={nota} /><p class="font-semibold text-text-secondary" set:html={resumo} /></div
		>
	</div>
</section>
