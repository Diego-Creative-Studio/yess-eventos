---
interface ItemCredibilidade {
	numero: string
	titulo: string
	descricao: string
}

interface Props {
	etiqueta: string
	titulo: string
	itens: ItemCredibilidade[]
}

const { etiqueta, titulo, itens } = Astro.props
---

<section class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5">
	<div
		data-animate
		class="mx-auto grid w-full gap-8 rounded-3xl border-2 border-stroke bg-surface p-6 lg:max-w-345 lg:grid-cols-[20rem_1fr] lg:items-center lg:p-8"
	>
		<div>
			<p class="text-sm font-semibold text-warm uppercase" set:html={etiqueta} />
			<h2 class="mt-2 text-2xl text-foreground" set:html={titulo} />
		</div>

		<ol
			class="grid gap-6 border-t border-stroke pt-8 md:grid-cols-2 lg:grid-cols-4 lg:border-t-0 lg:border-l lg:py-3 lg:pl-8"
		>
			{
				itens.map((item) => (
					<li>
						<p class="text-sm font-semibold text-warm">{item.numero}</p>
						<h3 class="mt-2 text-base text-foreground" set:html={item.titulo} />
						<p class="mt-1 text-sm text-muted" set:html={item.descricao} />
					</li>
				))
			}
		</ol>
	</div>
</section>
