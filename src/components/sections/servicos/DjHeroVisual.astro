---
// Visual decorativo: não representa níveis de áudio nem sincronização com o vídeo.
const bars = [40, 66, 88, 54, 100, 72, 46, 82, 58]
---

<div
	data-dj-visual
	data-compact="false"
	data-playing="false"
	data-motion-active="false"
	aria-hidden="true"
	class="dj-visual"
>
	<div class="dj-position">
		<div class="dj-console">
			<div class="dj-console__heading">
				<span>YESS <span class="dj-console__muted">/ DJ SET</span></span>
				<span class="dj-console__lights"><i></i><i></i><i></i></span>
			</div>
			<div class="dj-console__decks">
				<div class="dj-record"
					><span class="dj-record__shine"></span><span class="dj-record__label"></span></div
				>
				<div class="dj-wave">
					{
						bars.map((height, index) => (
							<span style={`--height: ${height}%; --delay: ${index * -0.11}s`} />
						))
					}
				</div>
				<div class="dj-record dj-record--violet"
					><span class="dj-record__shine"></span><span class="dj-record__label"></span></div
				>
			</div>
			<div class="dj-console__footer">
				<span>RITMO</span><span class="dj-fader"><i></i></span><span>IDENTIDADE</span>
			</div>
		</div>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-dj-visual]').forEach((visual) => {
		let inView = false
		const updateMotion = () => {
			visual.dataset.motionActive = String(inView && !document.hidden)
		}
		const observer = new IntersectionObserver(
			(entries) => {
				inView = entries.some((entry) => entry.isIntersecting)
				updateMotion()
			},
			{ rootMargin: '80px' },
		)
		observer.observe(visual)
		document.addEventListener('visibilitychange', updateMotion)
	})
</script>

<style>
	.dj-visual {
		position: absolute;
		inset: 0;
		z-index: 5;
		pointer-events: none;
		background: linear-gradient(180deg, transparent, rgb(7 10 15 / 0.35));
	}
	.dj-position {
		position: absolute;
		left: 50%;
		top: 50%;
		width: calc(100% - 2.5rem);
		max-width: 32rem;
		transform: translate(-50%, -50%) rotate(-5deg);
		transition:
			left 0.65s ease,
			top 0.65s ease,
			width 0.65s ease,
			transform 0.65s ease;
	}
	.dj-console {
		width: 100%;
		padding: clamp(1rem, 2.2vw, 1.75rem);
		border: 1px solid rgb(255 255 255 / 0.24);
		border-radius: 1.5rem;
		background: linear-gradient(135deg, rgb(13 22 38 / 0.96), rgb(20 13 43 / 0.94));
		box-shadow:
			0 20px 45px rgb(0 0 0 / 0.35),
			inset 0 1px rgb(255 255 255 / 0.08);
	}
	.dj-visual[data-compact='true'] {
		background: none;
	}
	.dj-visual[data-compact='true'] .dj-position {
		left: clamp(1rem, 2vw, 1.5rem);
		top: clamp(1rem, 2vw, 1.5rem);
		width: clamp(9.5rem, 20vw, 16rem);
		transform: translate(0, 0) rotate(-4deg);
	}
	.dj-visual[data-compact='true'] .dj-console {
		padding: 0.75rem;
		border-radius: 1rem;
		animation: dj-console-bounce 0.75s ease-in-out infinite;
	}
	.dj-visual[data-compact='true'] .dj-console__heading {
		font-size: 0.45rem;
		gap: 0.25rem;
	}
	.dj-visual[data-compact='true'] .dj-console__footer {
		font-size: 0.35rem;
		gap: 0.35rem;
	}
	.dj-visual[data-compact='true'] .dj-console__decks {
		margin-block: 0.75rem;
		gap: 0.5rem;
	}
	.dj-visual[data-compact='true'] .dj-wave {
		height: 2rem;
		gap: 1.5px;
	}
	.dj-visual[data-compact='true'] .dj-wave > span {
		width: 2px;
	}
	.dj-console__heading,
	.dj-console__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		font-family: var(--font-jakarta), sans-serif;
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #e8efff;
	}
	.dj-console__muted {
		color: #a9b9d1;
	}
	.dj-console__lights {
		display: flex;
		gap: 0.3rem;
	}
	.dj-console__lights i {
		width: 0.3rem;
		height: 0.3rem;
		border-radius: 50%;
		background: #2678ff;
	}
	.dj-console__lights i:last-child {
		background: #a88aff;
	}
	.dj-console__decks {
		display: grid;
		grid-template-columns: 1fr 0.5fr 1fr;
		align-items: center;
		gap: clamp(0.6rem, 1.5vw, 1.25rem);
		margin-block: clamp(1rem, 2.5vw, 1.75rem);
	}
	.dj-record {
		position: relative;
		aspect-ratio: 1;
		overflow: hidden;
		border: 1px solid rgb(104 160 255 / 0.6);
		border-radius: 50%;
		background: repeating-radial-gradient(circle, #111722 0 3px, #263045 4px, #111722 5px 8px);
	}
	.dj-record--violet {
		border-color: rgb(168 138 255 / 0.6);
	}
	.dj-record__shine {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: conic-gradient(
			from 25deg,
			transparent 0deg 30deg,
			rgb(212 228 255 / 0.2) 70deg,
			transparent 110deg 210deg,
			rgb(212 228 255 / 0.15) 250deg,
			transparent 290deg
		);
		animation: dj-record-turn 8s linear infinite;
	}
	.dj-record--violet .dj-record__shine {
		animation-direction: reverse;
	}
	.dj-record__label {
		position: absolute;
		inset: 32%;
		border: 1px solid rgb(255 255 255 / 0.25);
		border-radius: 50%;
		background:
			radial-gradient(circle, #e8efff 0 5%, #111722 6% 12%, transparent 13%),
			linear-gradient(135deg, #2678ff, #103e91);
	}
	.dj-record--violet .dj-record__label {
		background:
			radial-gradient(circle, #e8efff 0 5%, #111722 6% 12%, transparent 13%),
			linear-gradient(135deg, #ae87ff, #50228d);
	}
	.dj-wave {
		display: flex;
		height: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
		justify-content: center;
		gap: 3px;
	}
	.dj-wave > span {
		width: 3px;
		height: var(--height);
		border-radius: 999px;
		background: linear-gradient(#b29aff, #2678ff);
		animation: dj-wave-beat 0.75s ease-in-out var(--delay) infinite;
	}
	.dj-console__footer {
		font-size: 0.5rem;
		color: #b6c7e0;
	}
	.dj-fader {
		position: relative;
		width: 40%;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(90deg, #2678ff, #ae87ff);
	}
	.dj-fader i {
		position: absolute;
		left: 46%;
		top: -4px;
		width: 5px;
		height: 11px;
		border-radius: 2px;
		background: #e8efff;
		animation: dj-fader-mix 3s ease-in-out infinite;
	}
	@keyframes dj-record-turn {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes dj-wave-beat {
		0%,
		100% {
			transform: scaleY(0.55);
		}
		50% {
			transform: scaleY(1);
		}
	}
	@keyframes dj-fader-mix {
		0%,
		100% {
			transform: translateX(0);
		}
		35% {
			transform: translateX(-18px);
		}
		70% {
			transform: translateX(18px);
		}
	}
	@keyframes dj-console-bounce {
		0%,
		100% {
			transform: translateY(0) scale(1);
		}
		45% {
			transform: translateY(-4px) scale(1.02);
		}
	}
	.dj-visual[data-motion-active='false'] *,
	.dj-visual[data-compact='true'][data-playing='false'] * {
		animation-play-state: paused;
	}
	@media (max-width: 1023px) {
		.dj-record__shine,
		.dj-fader i {
			animation: none;
		}
		.dj-wave > span {
			animation-duration: 1s;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.dj-record__shine,
		.dj-wave > span,
		.dj-fader i,
		.dj-visual[data-compact='true'] .dj-console {
			animation: none;
		}
		.dj-position {
			transition: none;
		}
	}
</style>
