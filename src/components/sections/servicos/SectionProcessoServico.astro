---
interface EtapaProcesso {
	numero: string
	titulo: string
	descricao: string
}

interface Props {
	etiqueta: string
	titulo: string
	descricao: string
	etapas: [EtapaProcesso, EtapaProcesso, EtapaProcesso, EtapaProcesso]
}

const { etiqueta, titulo, descricao, etapas } = Astro.props
---

<section class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5">
	<div
		data-animate
		class="mx-auto grid w-full gap-8 rounded-3xl border-2 border-stroke bg-background p-6 lg:max-w-345 lg:grid-cols-[22.5rem_1fr] lg:p-10"
	>
		<div class="flex min-w-0 flex-col justify-between gap-10">
			<div>
				<p class="text-sm font-semibold text-primary uppercase" set:html={etiqueta} />
				<h2 class="mt-2 text-3xl text-foreground lg:text-4xl" set:html={titulo} />
				<p class="mt-4 text-base text-muted lg:text-lg" set:html={descricao} />
			</div>

			<div class="max-w-70">
				<p class="text-xs font-semibold text-muted uppercase">Fluxo completo</p>
				<div class="mt-2 flex items-center gap-1 text-xl font-medium text-primary">
					{
						etapas.map((etapa, indice) => (
							<>
								<span>{etapa.numero}</span>
								{indice < etapas.length - 1 && <span aria-hidden="true">&rarr;</span>}
							</>
						))
					}
				</div>
				<div class="mt-2 flex items-center gap-3" aria-hidden="true">
					{
						etapas.map((_, indice) => (
							<span
								class:list={[
									'h-1 rounded-full',
									indice === 0 ? 'w-10' : indice === 1 ? 'w-14' : indice === 2 ? 'w-17' : 'w-20',
									indice % 2 === 0 ? 'bg-primary' : 'bg-primary-soft',
								]}
							/>
						))
					}
				</div>
			</div>
		</div>

		<ol class="grid gap-4 md:grid-cols-2"
			>{
				etapas.map((etapa, indice) => (
					<li
						class:list={[
							'rounded-3xl p-6',
							indice === 1 ? 'bg-primary' : indice === 2 ? 'bg-primary-soft' : 'bg-surface-alt',
						]}
					>
						<>
							<p
								class:list={[
									'text-5xl font-extrabold lg:text-6xl',
									indice === 1 ? 'text-foreground' : 'text-primary',
								]}
							>
								{etapa.numero}
							</p>
							<h3 class="mt-5 text-2xl text-foreground" set:html={etapa.titulo} />
							<p
								class:list={['mt-2 text-sm', indice === 1 ? 'text-white' : 'text-foreground/75']}
								set:html={etapa.descricao}
							/>
						</>
					</li>
				))
			}</ol
		>
	</div>
</section>
