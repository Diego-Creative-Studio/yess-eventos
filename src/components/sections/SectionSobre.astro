---
import { Image } from 'astro:assets'

import Button from '@/components/Button.astro'
import Icon from '@/components/Icon.astro'
import imageAbout from '@/assets/sobre/yess-main.jpg'
import LightHalo from '@/components/LightHalo.astro'

const highlights = [
	{
		icon: 'calendario',
		iconClass: 'size-7',
		title: 'Planejamento personalizado',
		description:
			'Desenvolvemos projetos técnicos e 3D de acordo com o formato, o público e os objetivos do evento.',
	},
	{
		icon: 'ferramentas',
		iconClass: 'size-7',
		title: 'Equipamentos profissionais',
		description:
			'Painéis de LED, som, iluminação, TVs, projetores e estruturas profissionais para cada necessidade.',
	},
	{
		icon: 'equipe',
		iconClass: 'size-7',
		title: 'Equipe técnica especializada',
		description:
			'Equipe experiente para montagem, operação técnica e desmontagem com acompanhamento integrado.',
	},
] as const
---

<section
	id="sobre"
	aria-labelledby="titulo-sobre"
	class="relative overflow-hidden bg-background px-3 py-12 md:px-8 lg:px-16 lg:py-16"
>
	<!-- Light Halo 
	<span
		aria-hidden="true"
		class="pointer-events-none absolute -top-70 -right-98 size-170 rounded-full bg-primary/20 blur-3xl"
	></span>
	-->
	<LightHalo
		data-animate="scale"
		data-animate-duration={1.4}
		data-animate-delay={0.2}
		class="top-0 right-0"
		color="primary"
		size="lg"
		intensity="strong"
	/>

	<div class="relative z-10 mx-auto flex w-full flex-col gap-10 lg:max-w-345 xl:flex-row xl:gap-15">
		<div
			data-motion-image
			data-motion-parallax
			class="relative order-2 aspect-4/5 overflow-hidden rounded-3xl border-2 border-primary md:order-0 md:aspect-video xl:aspect-6/7 xl:w-149 xl:shrink-0"
		>
			<!-- Folga acima e abaixo para o parallax (±5%) não mostrar as bordas da foto. -->
			<div class="absolute inset-x-0 -inset-y-[8%]">
				<Image
					src={imageAbout}
					alt="Evento montado pela YESS com painel de LED exibindo a marca da empresa"
					class="size-full object-cover object-[50%_35%]"
				/>
			</div>
		</div>

		<div data-animate="fade-left" class="flex flex-1 flex-col xl:max-w-140 xl:pt-6">
			<p class="text-center text-sm font-semibold text-warm uppercase md:text-left"
				>Sobre a empresa</p
			>

			<h2
				data-motion-title
				id="titulo-sobre"
				class="mx-auto mt-2 text-center text-[1.75rem] leading-[1.2] text-foreground min-[400px]:text-3xl md:mx-0 md:text-left lg:text-5xl"
			>
				Estrutura, técnica e cuidado em cada evento.
			</h2>

			<div class="mx-auto mt-5 max-w-md space-y-2 text-center text-muted md:mx-0 md:text-left">
				<p>
					A YESS atende empresas, agências e produtores com soluções audiovisuais para reuniões,
					feiras, congressos, convenções e plenárias.
				</p>
				<p>
					Do projeto técnico à desmontagem, coordenamos equipamentos, montagem e operação para
					entregar segurança e organização em cada etapa.
				</p>
			</div>

			<ul class="mt-6 flex flex-col gap-5">
				{
					highlights.map((highlight) => (
						<li class="flex items-center gap-5">
							<span
								data-motion-icon
								class="flex size-15 shrink-0 items-center justify-center rounded-full bg-violet-dark text-white"
							>
								<Icon name={highlight.icon} class={highlight.iconClass} />
							</span>
							<div class="max-w-95 font-title text-sm">
								<h3 class="font-normal text-foreground">{highlight.title}</h3>
								<p class="text-muted">{highlight.description}</p>
							</div>
						</li>
					))
				}
			</ul>

			<Button
				label="Conheça nossa história"
				href="/sobre/"
				variant="outline"
				arrow
				animation="shine"
				class="mt-6 w-full self-start border-primary md:w-auto"
			/>
		</div>
	</div>
</section>
