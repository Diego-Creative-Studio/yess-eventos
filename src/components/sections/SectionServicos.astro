---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import Icon from '@/components/Icon.astro'
import imageLed from '@/assets/services/painel-led.png'
import imageSound from '@/assets/services/sonorizacao.png'
import imageLighting from '@/assets/services/iluminacao.png'
import Button from '@/components/Button.astro'
import LightHalo from '@/components/LightHalo.astro'

type IconName = 'estrutura' | 'equipe' | 'localizacao'

interface Benefit {
	label: string
	icon: IconName
}

interface Service {
	title: string
	description: string
	href: string
	image: ImageMetadata
}

const benefits: Benefit[] = [
	{ label: 'Estrutura sob medida', icon: 'estrutura' },
	{ label: 'Equipe técnica', icon: 'equipe' },
	{ label: 'Atendimento em São Paulo', icon: 'localizacao' },
]

const services: Service[] = [
	{
		title: 'Sonorização',
		description: 'Clareza e equilíbrio para todo o público.',
		href: '/som-e-iluminacao/',
		image: imageSound,
	},
	{
		title: 'Iluminação',
		description: 'Atmosfera e destaque para cada momento.',
		href: '/som-e-iluminacao/',
		image: imageLighting,
	},
]
---

<section
	id="servicos"
	class="relative isolate overflow-hidden bg-background px-3 pt-8 pb-8 md:px-8 lg:px-16 lg:py-18 lg:pb-16"
>
	<LightHalo
		data-animate="scale"
		data-animate-duration={1.4}
		data-animate-delay={0.2}
		class="top-0 left-0"
		color="primary"
		size="lg"
		intensity="strong"
	/>
	<div class="relative z-10 mx-auto flex w-full flex-col gap-8 lg:max-w-345">
		<div
			data-animate
			class="relative isolate flex flex-col items-stretch overflow-hidden rounded-3xl border-2 border-stroke bg-linear-to-br from-surface to-primary-soft/60 p-6 lg:flex-row lg:items-center"
		>
			<!-- Light Halo
			<span
				aria-hidden="true"
				class="pointer-events-none absolute -top-23 -left-22 size-50 rounded-full bg-primary/50 blur-3xl"
			></span>
			-->
			<div data-animate="fade-up" data-animate-delay={0.1} class="relative z-10 w-full lg:w-auto">
				<h2 class="text-2xl font-semibold text-foreground">
					Estrutura para eventos corporativos
				</h2>

				<p class="mt-1.5 text-sm text-muted">
					Painéis de LED, som, iluminação e TVs para empresas, feiras, congressos e apresentações.
				</p>
			</div>
			<span
				data-animate="fade-down"
				data-animate-delay={0.2}
				class="relative z-10 hidden h-28 border-r text-muted lg:block"></span>
			<ul
				class="relative z-10 mt-6 grid w-full gap-4 border-t border-stroke pt-6 lg:mt-0 lg:w-auto lg:grid-cols-3 lg:gap-6 lg:border-t-0 lg:p-7"
			>
				{
					benefits.map((benefit, index) => (
						<li
							data-animate="fade-up"
							data-animate-delay={index * 0.4}
							class="flex items-center gap-3"
						>
							<span
								data-motion-icon
								class="flex size-15 shrink-0 items-center justify-center rounded-full bg-violet-dark text-foreground"
							>
								<Icon name={benefit.icon} class="size-7.5" />
							</span>
							<span class="font-title text-sm text-foreground">{benefit.label}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div
			data-animate="fade-up"
			class="flex flex-col gap-5 py-2 lg:min-h-43.25 lg:flex-row lg:items-end lg:justify-between"
		>
			<div class="max-w-190">
				<p class="text-sm font-semibold text-warm uppercase">Nossos serviços</p>
				<h2 data-motion-title class="mt-2 text-3xl font-semibold text-foreground lg:text-4xl">
					Painéis de LED em primeiro plano. Tudo para seu evento.
				</h2>
			</div>
			<p class="max-w-86 text-sm text-muted">
				Soluções completas para eventos corporativos, feiras e congressos.
			</p>
		</div>

		<div class="grid gap-6 lg:grid-cols-12">
			<a
				data-motion-image
				data-motion-parallax
				href="/paineis-de-led-p2-e-p3/"
				class="group relative min-h-96 overflow-hidden rounded-3xl border-2 border-stroke lg:col-span-7 lg:min-h-130"
			>
				<Image
					src={imageLed}
					alt="Palco corporativo com painel de LED azul"
					class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
				/>
				<div
					class="absolute inset-0 bg-linear-to-t from-background from-20% to-transparent to-45% lg:from-20% lg:to-45%"
					aria-hidden="true"></div>
				<span class="absolute top-6 right-7 text-2xl text-foreground" aria-hidden="true">🡥</span>
				<div class="absolute right-7 bottom-7 left-7">
					<h3 class="text-2xl font-semibold text-foreground">Painéis de LED P2 e P3</h3>
					<p class="mt-1.5 text-sm text-muted">
						Alta definição, montagem sob medida e operação técnica para eventos corporativos.
					</p>
				</div>
			</a>

			<div class="grid gap-6 lg:col-span-5">
				{
					services.map((service) => (
						<a
							data-motion-image
							data-motion-parallax
							href={service.href}
							class="group relative min-h-72 overflow-hidden rounded-3xl border-2 border-stroke lg:min-h-62"
						>
							<Image
								src={service.image}
								alt=""
								class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
							/>
							<div
								class="absolute inset-0 bg-linear-to-t from-background from-20% to-transparent to-50% lg:from-30% lg:to-60%"
								aria-hidden="true"
							/>
							<span class="absolute top-6 right-7 text-2xl text-foreground" aria-hidden="true">
								🡥
							</span>
							<div class="absolute right-7 bottom-7 left-7">
								<h3 class="text-2xl font-semibold text-foreground">{service.title}</h3>
								<p class="mt-1.5 text-sm text-muted">{service.description}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>

		<div class="grid gap-6 text-shadow-lg lg:grid-cols-12">
			<a
				data-animate="fade-down"
				href="/tvs-e-monitores/"
				class="group relative isolate flex min-h-65 flex-col justify-end overflow-hidden rounded-3xl border-2 border-stroke bg-linear-to-r from-background via-primary-soft to-violet p-7 before:pointer-events-none before:absolute before:inset-y-[-50%] before:left-[-35%] before:w-[22%] before:-skew-x-12 before:bg-white/35 before:blur-sm before:transition-transform before:duration-700 before:content-[''] motion-safe:hover:before:translate-x-[650%] lg:col-span-4"
			>
				<span class="absolute top-6 right-7 z-10 text-2xl text-foreground" aria-hidden="true"
					>🡥</span
				>
				<h3 class="relative z-10 text-2xl font-semibold text-foreground">Locação de TVs</h3>
				<p class="relative z-10 mt-1.5 max-w-72 text-sm text-muted">
					Monitores para feiras, congressos e apresentações.
				</p>
			</a>

			<div
				data-animate="fade-down"
				data-animate-delay={0.2}
				class="flex min-h-65 flex-col items-center gap-8 rounded-3xl border-2 border-primary bg-linear-to-r from-primary-soft to-primary p-7 lg:col-span-8 lg:flex-row lg:items-center lg:justify-between lg:px-9"
			>
				<div class="w-full">
					<h3 class="text-2xl font-semibold text-foreground"> Soluções para cada necessidade </h3>
					<p class="mt-2 text-muted text-shadow-lg">
						Painéis, som, iluminação e TVs com planejamento e operação técnica.
					</p>
				</div>
				<!-- 
				<a
					href="#todos-os-servicos"
					class="flex w-full shrink-0 items-center justify-center gap-2 rounded-full bg-white p-4 font-title text-sm font-semibold text-primary transition-colors duration-300 hover:bg-background hover:text-foreground md:w-auto"
				>
					Ver todos os serviços <Icon name="arrow" class="size-4" />
				</a>
				-->
				<Button
					label="Soluções corporativas"
					href="/solucoes-corporativas/"
					variant="tertiary"
					class="flex w-full shrink-0 transition-colors duration-300 md:w-auto"
					arrow
					animation="shine"
				/>
			</div>
		</div>
	</div>
</section>
