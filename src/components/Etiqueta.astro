---
interface Props {
	texto: string
	corFundo?: string
	corTexto?: string
	corBolinha?: string
	animar?: boolean
	class?: string
}

const {
	texto,
	corFundo = 'bg-violet-dark',
	corTexto = 'text-foreground',
	corBolinha = 'bg-foreground',
	animar = false,
	class: className,
} = Astro.props
---

<p
	data-animate={animar || undefined}
	class:list={[
		'inline-flex items-center justify-center gap-2 rounded-pill px-3 py-2 text-center text-xs font-semibold md:text-sm',
		corFundo,
		corTexto,
		className,
	]}
>
	<span class:list={['size-2 shrink-0 rounded-full', corBolinha]} aria-hidden="true"></span>
	<span class="uppercase" set:html={texto} />
</p>
