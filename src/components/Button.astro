---
import Icon from '@/components/Icon.astro'

interface Props {
	label: string
	href?: string
	type?: 'button' | 'submit' | 'reset'
	id?: string
	variant?: 'primary' | 'outline' | 'tertiary' | 'alternative' | 'whatsapp'
	animation?: 'none' | 'shine'
	arrow?: boolean
	whatsapp?: boolean
	icon?: 'arrow' | 'play' | 'whatsapp'
	iconPosition?: 'left' | 'right'
	iconClass?: string
	'data-animate'?: 'fade' | 'fade-up' | 'fade-down' | 'fade-left' | 'fade-right' | 'scale'
	'data-animate-delay'?: number
	class?: string
	target?: string
	rel?: string
	disabled?: boolean
	/** Atributos data-* extras (ex.: para scripts). */
	[attr: `data-${string}`]: string | number | boolean | undefined
}

const {
	label,
	href,
	type = 'button',
	id,
	variant = 'primary',
	animation = 'none',
	arrow = false,
	icon,
	iconPosition = 'right',
	iconClass: customIconClass,
	'data-animate': dataAnimate,
	'data-animate-delay': dataAnimateDelay,
	class: className,
	target,
	rel,
	disabled,
	...attrs
} = Astro.props

const variants = {
	primary: 'border-transparent bg-primary text-foreground hover:bg-primary-dark',
	whatsapp: 'border-transparent bg-[#1a8f4c] text-white hover:bg-[#147a3f]',
	outline:
		'border-2 border-stroke bg-transparent text-foreground hover:border-primary hover:bg-primary-dark',
	tertiary:
		' bg-white border-0 text-sm font-semibold text-primary  hover:bg-background hover:text-foreground',
	alternative:
		'w-full !border-0 bg-white !p-6 text-center text-sm text-background hover:bg-background hover:text-foreground md:w-fit md:shrink-0 md:!p-7 md:text-lg md:whitespace-nowrap',
}

const animations = {
	none: '',
	shine:
		"relative isolate overflow-hidden before:pointer-events-none before:absolute before:inset-y-[-50%] before:left-[-35%] before:w-[22%] before:-skew-x-12 before:bg-white/35 before:blur-sm before:transition-transform before:duration-700 before:content-[''] motion-safe:hover:before:translate-x-[650%]",
}

const iconName = icon ?? (arrow ? 'arrow' : undefined)
const iconClass =
	customIconClass ??
	(variant === 'alternative' ? 'relative z-10 block size-3 translate-y-px' : 'relative z-10 size-4')
const Tag = href ? 'a' : 'button'
---

<Tag
	{id}
	{href}
	{target}
	{rel}
	disabled={href ? undefined : disabled}
	type={href ? undefined : type}
	{...attrs}
	data-animate={dataAnimate}
	data-animate-delay={dataAnimateDelay}
	class:list={[
		'inline-flex min-h-13 items-center justify-center gap-2 rounded-full border px-6 py-4 font-title text-sm leading-5 font-semibold transition-[color,background-color,border-color,transform,box-shadow] duration-200',
		variants[variant],
		animations[animation],
		className,
	]}
>
	{iconName && iconPosition === 'left' && <Icon name={iconName} class={iconClass} />}
	<span class="relative z-10" set:html={label} />
	{iconName && iconPosition === 'right' && <Icon name={iconName} class={iconClass} />}
</Tag>
