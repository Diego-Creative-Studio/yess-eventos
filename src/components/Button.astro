---
import Icon from '@/components/Icon.astro'

interface Props {
	label: string
	href: string
	variant?: 'primary' | 'outline'
	arrow?: boolean
	class?: string
}

const { label, href, variant = 'primary', arrow = false, class: className } = Astro.props

const variants = {
	primary:
		'border-primary bg-primary text-foreground hover:border-primary-dark hover:bg-primary-dark',
	outline: 'border-stroke bg-transparent text-foreground hover:border-primary hover:text-primary',
}
---

<a
	{href}
	class:list={[
		'inline-flex min-h-13 items-center justify-center gap-2 rounded-pill border px-6 py-4 font-title text-sm leading-5 font-semibold transition-colors duration-200',
		variants[variant],
		className,
	]}
>
	<span set:html={label} />
	{arrow && <Icon name="arrow" class="size-4" />}
</a>
