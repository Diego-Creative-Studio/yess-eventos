---
import Icon from '@/components/Icon.astro'
import Button from '@/components/Button.astro'
import LightHalo from '@/components/LightHalo.astro'
import site from '@/data/site.json'
---

<footer id="contato" class="px-3 pb-24 md:px-8 lg:px-16 lg:pb-0">
	<div
		class="relative mx-auto w-full overflow-hidden rounded-3xl border-2 border-primary bg-linear-30 from-[#0d121c] to-[#142b4a] px-6 py-10 md:px-8 lg:min-h-94.75 lg:max-w-345 lg:px-10 lg:py-8"
	>
		<!-- A luz nasce abaixo da borda inferior e sobe até o meio quando o footer aparece. -->
		<span data-footer-rise aria-hidden="true" class="pointer-events-none absolute inset-0">
			<LightHalo
				data-animate={false}
				class="bottom-0 left-1/2"
				color="primary"
				size="lg"
				intensity="strong"
				float
			/>
		</span>

		<div
			class="relative z-10 grid gap-10 text-center min-[420px]:grid-cols-2 min-[420px]:text-left xl:flex xl:min-h-52.5 xl:justify-between xl:gap-0"
		>
			<div class="flex flex-col items-center gap-3 min-[420px]:items-start xl:w-65">
				<p class="text-xs leading-4 font-semibold tracking-wide text-primary uppercase">
					Tecnologia • Operação • Presença
				</p>
				<p class="text-xl leading-7 font-semibold text-foreground">YESS AUDIOVISUAL</p>
				<p class="max-w-64 text-sm leading-6 text-muted min-[420px]:max-w-48 xl:max-w-39">
					Soluções audiovisuais para eventos em São Paulo e Guarulhos.
				</p>
			</div>

			<nav
				aria-label="Serviços"
				class="flex flex-col items-center gap-2.5 min-[420px]:items-start xl:w-70"
			>
				<h2 class="text-xl leading-7 font-semibold text-foreground">Serviços</h2>
				<a
					href="/estrutura-audiovisual-para-eventos/"
					class="text-sm leading-6 text-muted transition-colors hover:text-foreground"
					>Todos os equipamentos ↗</a
				>
				<a
					href="/paineis-de-led-p2-e-p3/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Painéis de LED P2 e P3
				</a>
				<a
					href="/som-e-iluminacao/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Sonorização
				</a>
				<a
					href="/som-e-iluminacao/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Iluminação
				</a>
				<a
					href="/tvs-e-monitores/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>TVs para eventos
				</a>
				<a
					href="/solucoes-corporativas/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Soluções corporativas
				</a>
				<a
					href="/estruturas-e-cenografia-para-eventos/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Estruturas e cenografia
				</a>
				<a
					href="/projetos-tecnicos-para-eventos/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Projetos técnicos e 3D
				</a>
			</nav>

			<nav
				aria-label="Empresa"
				class="flex flex-col items-center gap-2.5 min-[420px]:items-start xl:w-55"
			>
				<h2 class="text-xl leading-7 font-semibold text-foreground">Empresa</h2>
				<a
					href="/sobre/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Sobre
				</a>
				<a
					href="/contato/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Contato
				</a>
			</nav>

			<div class="flex flex-col items-center gap-2.5 min-[420px]:items-start xl:w-62.5">
				<h2 class="text-xl leading-7 font-semibold text-foreground">Contato</h2>
				<a
					href="/contato/#canais"
					class="inline-flex min-h-10.5 items-center gap-2.5 rounded-small border-2 border-stroke bg-surface-alt px-3 py-2.5 font-title text-sm font-semibold text-foreground transition-colors hover:border-primary"
				>
					<Icon name="whatsapp" class="size-5" /> WhatsApp ↗
				</a>
				<a
					href="/contato/#canais"
					class="inline-flex min-h-10.5 items-center gap-2.5 rounded-small border-2 border-stroke bg-surface-alt px-3 py-2.5 font-title text-sm font-semibold text-foreground transition-colors hover:border-primary"
				>
					<Icon name="email" class="size-5" /> E-mail ↗
				</a>
				<a
					href="/contato/#canais"
					class="inline-flex min-h-10.5 items-center gap-2.5 rounded-small border-2 border-stroke bg-surface-alt px-3 py-2.5 font-title text-sm font-semibold text-foreground transition-colors hover:border-primary"
				>
					<Icon name="instagram" class="size-5" /> Instagram ↗
				</a>
			</div>
		</div>

		<div
			class="relative z-10 mt-10 flex flex-col items-center gap-6 border-t border-stroke pt-6 text-center min-[420px]:items-stretch min-[420px]:text-left lg:min-h-18 lg:flex-row lg:items-center lg:justify-between"
		>
			<div
				class="flex flex-col items-center gap-1 text-xs leading-4 font-semibold tracking-wide uppercase min-[420px]:items-start"
			>
				<p
					class="flex items-center justify-center gap-2 text-text-secondary min-[420px]:justify-start"
				>
					<span class="size-2 shrink-0 rounded-full bg-primary"></span>
					Atendimento direto • Resposta humana
				</p>
				<p class="text-muted normal-case">
					© {new Date().getFullYear()} {site.legalName} · CNPJ {site.cnpj}. Todos os direitos reservados.
				</p>
				<p class="text-muted normal-case">
					Desenvolvido por{' '}
					<a
						href={site.developer.url}
						target="_blank"
						rel="noopener"
						class="font-bold text-text-secondary underline-offset-4 transition-colors hover:text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-primary"
					>
						{site.developer.name}
					</a>
				</p>
			</div>

			<Button
				label="Solicitar orçamento"
				href="/contato/#canais"
				variant="primary"
				class="w-full uppercase md:w-auto"
				animation="shine"
			/>
		</div>
	</div>
</footer>

<script>
	const rise = document.querySelector<HTMLElement>('[data-footer-rise]')

	if (rise) {
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return
				rise.classList.add('is-risen')
				observer.disconnect()
			},
			{ threshold: 0.35 },
		)
		observer.observe(rise)
	}
</script>

<style>
	[data-footer-rise] {
		transition:
			transform 2.6s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 1.8s ease-out;
	}

	/* Estado inicial só com JS, para a luz nunca sumir se o script não rodar. */
	:global(.js) [data-footer-rise]:not(.is-risen) {
		transform: translateY(30%);
		opacity: 0;
	}

	[data-footer-rise].is-risen {
		transform: translateY(-50%);
	}

	:global(html:not(.js)) [data-footer-rise] {
		transform: translateY(-50%);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-footer-rise],
		:global(.js) [data-footer-rise]:not(.is-risen) {
			transform: translateY(-50%);
			opacity: 1;
			transition: none;
		}
	}
</style>
