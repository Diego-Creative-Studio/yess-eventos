---
import Icon from '@/components/Icon.astro'
import Button from '@/components/Button.astro'
---

<footer id="contato" class="px-3 md:px-8 lg:px-16">
	<div
		class="relative mx-auto w-full overflow-hidden rounded-3xl border-2 border-primary bg-linear-30 from-[#0d121c] to-[#142b4a] px-6 py-8 lg:min-h-94.75 lg:max-w-345 lg:px-10"
	>
		<span
			aria-hidden="true"
			class="pointer-events-none absolute top-56 left-1/4 size-166 rounded-full bg-primary/20 blur-3xl"
		></span>

		<div
			class="relative z-10 grid gap-10 md:grid-cols-2 xl:flex xl:min-h-52.5 xl:justify-between xl:gap-0"
		>
			<div class="flex flex-col gap-3 xl:w-65">
				<p class="text-xs leading-4 font-semibold tracking-wide text-primary uppercase">
					Tecnologia • Operação • Presença
				</p>
				<p class="text-xl leading-7 font-semibold text-foreground">YESS AUDIOVISUAL</p>
				<p class="max-w-39 text-sm leading-6 text-muted">
					Painéis de LED, som, iluminação e TVs para eventos corporativos.
				</p>
			</div>

			<nav aria-label="Serviços" class="flex flex-col gap-2.5 xl:w-70">
				<h2 class="text-xl leading-7 font-semibold text-foreground">Serviços</h2>
				<a
					href="/paineis-de-led-p2-e-p3/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Painéis de LED P2 e P3
				</a>
				<a
					href="/som-e-iluminacao/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Sonorização
				</a>
				<a
					href="/som-e-iluminacao/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Iluminação
				</a>
				<a
					href="/tvs-e-monitores/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Locação de TVs
				</a>
				<a
					href="/solucoes-corporativas/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Soluções corporativas
				</a>
			</nav>

			<nav aria-label="Empresa" class="flex flex-col gap-2.5 xl:w-55">
				<h2 class="text-xl leading-7 font-semibold text-foreground">Empresa</h2>
				<a
					href="/sobre/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Sobre
				</a>
				<a
					href="/contato/"
					class="flex items-center gap-2 text-sm leading-6 text-muted transition-colors hover:text-foreground"
				>
					<span class="size-1.5 shrink-0 rounded-full bg-primary"></span>Contato
				</a>
			</nav>

			<div class="flex flex-col items-start gap-2.5 xl:w-62.5">
				<h2 class="text-xl leading-7 font-semibold text-foreground">Contato</h2>
				<a
					href="#contato"
					class="inline-flex min-h-10.5 items-center gap-2.5 rounded-small border-2 border-stroke bg-surface-alt px-3 py-2.5 font-title text-sm font-semibold text-foreground transition-colors hover:border-primary"
				>
					<Icon name="whatsapp" class="size-5" /> WhatsApp ↗
				</a>
				<a
					href="#contato"
					class="inline-flex min-h-10.5 items-center gap-2.5 rounded-small border-2 border-stroke bg-surface-alt px-3 py-2.5 font-title text-sm font-semibold text-foreground transition-colors hover:border-primary"
				>
					<Icon name="email" class="size-5" /> E-mail ↗
				</a>
				<a
					href="#contato"
					class="inline-flex min-h-10.5 items-center gap-2.5 rounded-small border-2 border-stroke bg-surface-alt px-3 py-2.5 font-title text-sm font-semibold text-foreground transition-colors hover:border-primary"
				>
					<Icon name="instagram" class="size-5" /> Instagram ↗
				</a>
			</div>
		</div>

		<div
			class="relative z-10 mt-8 flex flex-col gap-6 border-t border-stroke pt-4 lg:min-h-18 lg:flex-row lg:items-center lg:justify-between"
		>
			<div class="flex flex-col gap-1 text-xs leading-4 font-semibold tracking-wide uppercase">
				<p class="flex items-center gap-2 text-text-secondary">
					<span class="size-2 shrink-0 rounded-full bg-primary"></span>
					Atendimento direto • Resposta humana
				</p>
				<p class="text-muted normal-case">
					© {new Date().getFullYear()} YESS Audiovisual. Todos os direitos reservados.
				</p>
			</div>

			<Button
				label="Solicitar orçamento"
				href="#orcamento"
				variant="primary"
				class="w-full uppercase md:w-auto"
				animation="shine"
			/>
		</div>
	</div>
</footer>
