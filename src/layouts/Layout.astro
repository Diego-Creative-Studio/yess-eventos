---
import '@/styles/global.css'

import { Font } from 'astro:assets'
import Seo from '@/components/Seo.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'

type AnimationName = 'fade' | 'fade-up' | 'fade-down' | 'fade-left' | 'fade-right' | 'scale'

interface Props {
	title?: string
	description?: string
	image?: string
	type?: string
	noindex?: boolean
	headerClass?: string
	animationDefault?: AnimationName
	animationDuration?: number
	animationDistance?: number
	animationStart?: string
}

const {
	title,
	description,
	image,
	type,
	noindex,
	headerClass,
	animationDefault = 'fade',
	animationDuration = 1,
	animationDistance = 32,
	animationStart = 'top 80%',
} = Astro.props
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="YESS Eventos" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<Seo {title} {description} {image} {type} {noindex} />
		<Font cssVariable="--font-jakarta" preload />
		<Font cssVariable="--font-inter" />
	</head>
	<body
		class="bg-primary-soft font-sans text-white antialiased"
		data-animate-default={animationDefault}
		data-animate-duration={animationDuration}
		data-animate-distance={animationDistance}
		data-animate-start={animationStart}
	>
		<a
			href="#conteudo"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-5 focus:py-3 focus:font-bold focus:text-white"
		>
			Pular para o conteúdo
		</a>
		<Header class={headerClass} />
		<slot />
		<Footer />
		<script>
			import '@/scripts/smooth-scroll'
			import '@/scripts/reveal-animations'
		</script>
	</body></html
>

<style is:global>
	[x-cloak] {
		display: none !important;
	}
</style>
