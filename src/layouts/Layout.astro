---
import '@/styles/global.css'

import { Font } from 'astro:assets'
import Seo from '@/components/Seo.astro'
import Header from '@/components/Header.astro'
import SiteSchema from '@/components/SiteSchema.astro'
import Footer from '@/components/Footer.astro'
import ConsentHead from '@/components/ConsentHead.astro'
import ConsentDevTracking from '@/components/ConsentDevTracking.astro'
import CookieConsent from '@/components/CookieConsent.astro'
import privacy from '@/data/privacy.json'

type AnimationName = 'fade' | 'fade-up' | 'fade-down' | 'fade-left' | 'fade-right' | 'scale'

interface Props {
	title?: string
	description?: string
	image?: string
	type?: string
	noindex?: boolean
	headerClass?: string
	footerTheme?: 'default' | 'dark'
	animationDefault?: AnimationName
	animationDuration?: number
	animationDistance?: number
	animationStart?: string
}

const {
	title,
	description,
	image,
	type,
	noindex,
	headerClass,
	footerTheme = 'default',
	animationDefault = 'fade',
	animationDuration = 1,
	animationDistance = 32,
	animationStart = 'top 80%',
} = Astro.props
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		{(privacy.trackingEnabled || import.meta.env.DEV) && <ConsentHead />}
		{import.meta.env.DEV && <ConsentDevTracking />}
		<!-- Transição suave entre páginas; fica inline para valer já na chegada da nova página. -->
		<style is:inline>
			@view-transition {
				navigation: auto;
			}
		</style>
		<script is:inline>
			document.documentElement.classList.add('js')
		</script>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
		/>

		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
		<meta name="author" content="YESS Audiovisual & Eventos" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<Seo {title} {description} {image} {type} {noindex} />
		<SiteSchema />
		<!-- Prioriza os subconjuntos usados no conteúdo; latin-ext continua disponível sob demanda. -->
		<Font cssVariable="--font-jakarta" preload={[{ subset: 'latin' }]} />
		<Font cssVariable="--font-inter" preload={[{ subset: 'latin' }]} />
	</head>
	<body
		class:list={[
			'font-sans text-white antialiased',
			footerTheme === 'dark' ? 'bg-background' : 'bg-primary-soft',
		]}
		data-animate-default={animationDefault}
		data-animate-duration={animationDuration}
		data-animate-distance={animationDistance}
		data-animate-start={animationStart}
	>
		<a
			href="#conteudo"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-5 focus:py-3 focus:font-bold focus:text-white"
		>
			Pular para o conteúdo
		</a>
		<Header class={headerClass} />
		<slot />
		<Footer theme={footerTheme} />
		{(privacy.trackingEnabled || import.meta.env.DEV) && <CookieConsent />}
		<script>
			import '@/scripts/smooth-scroll'
			import '@/scripts/reveal-animations'
			import '@/scripts/premium-animations'
		</script>
	</body></html
>

<style is:global>
	[x-cloak] {
		display: none !important;
	}
</style>
