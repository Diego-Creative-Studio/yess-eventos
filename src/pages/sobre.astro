---
import { Image } from 'astro:assets'

import Layout from '@/layouts/Layout.astro'
import SectionChamadaServico from '@/components/sections/servicos/SectionChamadaServico.astro'
import SectionProcessoServico from '@/components/sections/servicos/SectionProcessoServico.astro'

import imagemTrajetoria from '@/assets/sobre/11c5379ee025181be2e20c3b982a46c0c5185ada.jpg'
import imagemMontagem from '@/assets/sobre/54c02eff8137b407cd854ff7ff42767d02794245.jpg'
import imagemLuz from '@/assets/sobre/f78aebeac4a0c8ddb3f412731b22cb418bf03c8a.jpg'
import imagemOperacao from '@/assets/sobre/8c28f5efd02aeca6f7b107c079f1d473ec3651c0.jpg'

const capacidades = [
	'Projeto sob medida',
	'Montagem técnica',
	'Processamento de vídeo',
	'Operação no evento',
]

const bastidores = [
	{
		imagem: imagemMontagem,
		alt: 'Estrutura de LED preparada para um evento corporativo',
		titulo: 'Montagem que prepara o palco',
		texto: 'Estrutura, luz e imagem alinhadas antes da abertura das portas.',
	},
	{
		imagem: imagemLuz,
		alt: 'Palco iluminado durante uma apresentação',
		titulo: 'Imagem e luz em sintonia',
		texto: 'Cada elemento trabalhando para valorizar a mensagem do evento.',
	},
	{
		imagem: imagemOperacao,
		alt: 'Operação audiovisual acompanhando um evento corporativo',
		titulo: 'Operação técnica presente',
		texto: 'Acompanhamento de sinal, conteúdo e programação durante o evento.',
	},
]
---

<Layout
	title="Sobre a YESS Audiovisual e Eventos"
	description="Conheça a trajetória, o método e a equipe da YESS, especialista em soluções audiovisuais coordenadas para eventos corporativos."
>
	<main id="conteudo" class="overflow-hidden bg-stroke">
		<section class="px-3 py-7.5 md:px-8 lg:h-140 lg:px-16 lg:py-7.5">
			<div
				data-sobre-reveal
				class="mx-auto flex min-h-125 w-full max-w-345 flex-col justify-between gap-10 rounded-[28px] border border-stroke bg-surface p-7 md:p-10 lg:h-125"
			>
				<div class="grid gap-10 lg:grid-cols-[700fr_460fr] lg:items-center lg:gap-18">
					<div>
						<p class="font-title text-sm leading-5 font-semibold text-primary uppercase">
							Quem somos hoje
						</p>
						<h1
							class="mt-3 max-w-175 text-4xl leading-tight font-semibold tracking-[-0.01em] text-foreground md:text-5xl md:leading-[58px]"
						>
							Uma equipe que assume<br class="hidden sm:block" /> a entrega por inteiro.
						</h1>
					</div>

					<div class="max-w-115">
						<p class="font-title text-sm leading-5 font-semibold text-primary uppercase">
							Do briefing ao encerramento
						</p>
						<p class="mt-3 text-base leading-7.5 text-muted md:text-lg">
							A YESS reúne planejamento, montagem e operação audiovisual para eventos corporativos.
							Cada solução nasce do espaço, do público e da mensagem que precisa chegar com clareza.
						</p>
					</div>
				</div>

				<div class="flex flex-wrap items-center gap-x-8 gap-y-3 rounded-[20px] bg-primary p-6">
					{
						capacidades.map((capacidade) => (
							<p class="font-title text-xs leading-5 font-semibold text-white uppercase sm:text-sm">
								{capacidade}
							</p>
						))
					}
				</div>
			</div>
		</section>

		<section class="px-3 py-7.5 md:px-8 lg:h-177.5 lg:px-16 lg:py-7.5">
			<div
				data-sobre-reveal
				class="mx-auto grid w-full max-w-345 overflow-hidden rounded-[28px] border border-stroke bg-linear-to-r from-[#090d17] to-[#08243d] xl:h-162.5 xl:grid-cols-[700fr_612fr]"
			>
				<div class="flex flex-col p-7 md:p-12">
					<div>
						<p
							class="font-title text-xs leading-4 font-semibold tracking-[0.02em] text-primary uppercase"
						>
							Nossa trajetória
						</p>
						<h2
							class="mt-2.5 max-w-151 text-3xl leading-tight font-semibold tracking-[-0.005em] text-foreground md:text-[40px] md:leading-[50px]"
						>
							Fundada em 2012. Presente em cada detalhe.
						</h2>
						<p class="mt-2.5 max-w-140 text-base leading-7.5 text-muted md:text-lg">
							A YESS nasceu em São Paulo para tornar a operação audiovisual mais clara, segura e
							próxima — do primeiro briefing ao encerramento do evento.
						</p>
					</div>

					<div class="mt-8 grid gap-6 sm:grid-cols-[190px_1px_1fr] sm:items-center">
						<div>
							<p
								class="font-title text-[64px] leading-none font-extrabold tracking-[-0.01em] text-primary md:text-7xl"
								>2012</p
							>
							<p
								class="mt-0.5 max-w-30 font-title text-xs leading-4 font-semibold tracking-[0.02em] text-muted uppercase"
							>
								Ano de fundação
							</p>
						</div>
						<span aria-hidden="true" class="hidden h-29 w-px bg-primary sm:block"></span>
						<div>
							<h3 class="text-xl leading-7 font-semibold text-foreground">
								Uma trajetória construída nos bastidores
							</h3>
							<p class="mt-3 text-[15px] leading-6 text-muted">
								Ao longo de mais de uma década, a empresa passou a reunir painéis de LED, som,
								iluminação, telas e operação técnica em uma entrega coordenada para eventos
								corporativos.
							</p>
						</div>
					</div>

					<p
						class="mt-6 font-title text-xs leading-4 font-semibold tracking-[0.02em] text-primary uppercase xl:mt-auto"
					>
						Planejamento&nbsp; • &nbsp;Técnica&nbsp; • &nbsp;Presença
					</p>
				</div>

				<div class="relative min-h-100 xl:min-h-0">
					<Image
						src={imagemTrajetoria}
						alt="Evento produzido pela YESS com estrutura audiovisual completa"
						class="absolute inset-0 size-full object-cover"
					/>
				</div>
			</div>
		</section>

		<SectionProcessoServico
			etiqueta="Método YESS"
			titulo="Clareza em cada etapa"
			descricao="A equipe combina escuta, planejamento e presença técnica para transformar necessidades em uma entrega segura."
			etapas={[
				{
					numero: '01',
					titulo: 'Escuta',
					descricao: 'Entendemos o evento antes de indicar equipamentos.',
				},
				{
					numero: '02',
					titulo: 'Clareza',
					descricao: 'Escopo, responsabilidades e etapas explicados com objetividade.',
				},
				{
					numero: '03',
					titulo: 'Cuidado técnico',
					descricao: 'Montagem, testes e acabamento tratados como parte da entrega.',
				},
				{
					numero: '04',
					titulo: 'Presença',
					descricao: 'Equipe acompanhando o evento do início ao encerramento.',
				},
			]}
		/>

		<section class="px-3 py-7.5 md:px-8 lg:h-210 lg:px-16 lg:py-7.5">
			<div
				data-sobre-reveal
				class="mx-auto w-full max-w-345 rounded-[28px] border border-stroke bg-surface p-7 md:p-10 lg:h-195"
			>
				<h2
					class="text-3xl leading-tight font-semibold tracking-[-0.005em] text-foreground md:text-[40px] md:leading-[50px]"
				>
					Pessoas e bastidores
				</h2>
				<p class="mt-3.5 max-w-195 text-base leading-7.5 text-muted md:text-lg">
					Tecnologia chama atenção. Pessoas garantem que cada detalhe funcione antes, durante e
					depois do evento.
				</p>

				<div class="mt-10 grid gap-4 lg:mt-20 lg:grid-cols-3">
					{
						bastidores.map((item) => (
							<article class="relative min-h-117.5 overflow-hidden rounded-[20px]">
								<Image
									src={item.imagem}
									alt={item.alt}
									class="absolute inset-0 size-full object-cover"
								/>
								<div class="absolute inset-0 bg-linear-to-b from-black/5 via-black/10 to-black/95" />
								<div class="absolute right-6 bottom-6 left-6">
									<h3 class="text-xl leading-7 font-semibold text-foreground">{item.titulo}</h3>
									<p class="mt-2 text-[15px] leading-6 text-muted">{item.texto}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<SectionChamadaServico
			titulo="Vamos construir um evento bem resolvido?"
			descricao="Converse com a equipe sobre formato, espaço, público e necessidades técnicas."
			textoBotao="Solicitar projeto e orçamento"
			linkBotao="#contato"
		/>
	</main>

	<script>
		import { gsap } from 'gsap'
		import { ScrollTrigger } from 'gsap/ScrollTrigger'

		gsap.registerPlugin(ScrollTrigger)

		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			gsap.utils.toArray<HTMLElement>('[data-sobre-reveal]').forEach((element) => {
				gsap.fromTo(
					element,
					{ opacity: 0, y: 28 },
					{
						opacity: 1,
						y: 0,
						duration: 0.8,
						ease: 'power2.out',
						scrollTrigger: { trigger: element, start: 'top 90%', once: true },
					},
				)
			})
		}
	</script>
</Layout>
