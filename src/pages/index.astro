---
import Layout from '@/layouts/Layout.astro'

import SectionHero from '@/components/sections/SectionHero.astro'
import SectionServicos from '@/components/sections/SectionServicos.astro'
import SectionSobre from '@/components/sections/SectionSobre.astro'
import SectionTrabalhos from '@/components/sections/SectionTrabalhos.astro'
import SectionProcesso from '@/components/sections/SectionProcesso.astro'
---

<Layout
	title="Locação de Painel de LED para Eventos em SP | YESS"
	description="Locação de painéis de LED P2 e P3, som, iluminação, TVs e projetores para eventos em São Paulo e Guarulhos, com projeto, montagem e operação técnica."
	headerClass="home-header"
>
	<main id="conteudo">
		<SectionHero />
		<SectionServicos />
		<SectionSobre />
		<SectionTrabalhos />
		<SectionProcesso />
	</main>
</Layout>
