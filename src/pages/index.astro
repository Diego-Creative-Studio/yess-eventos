---
import Layout from '@/layouts/Layout.astro'

import SectionHero from '@/components/sections/SectionHero.astro'
import SectionServicos from '@/components/sections/SectionServicos.astro'
import SectionSobre from '@/components/sections/SectionSobre.astro'
import SectionTrabalhos from '@/components/sections/SectionTrabalhos.astro'
import SectionProcesso from '@/components/sections/SectionProcesso.astro'
---

<Layout title="YESS Eventos | Experiências que ficam">
	<main id="conteudo">
		<SectionHero />
		<SectionServicos />
		<SectionSobre />
		<SectionTrabalhos />
		<SectionProcesso />
	</main>

	<script>
		import { gsap } from 'gsap'
		import { ScrollTrigger } from 'gsap/ScrollTrigger'

		gsap.registerPlugin(ScrollTrigger)

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

		if (!reduceMotion) {
			gsap.utils.toArray<HTMLElement>('[data-animate]').forEach((element) => {
				gsap.fromTo(
					element,
					{ opacity: 0 },
					{
						opacity: 1,
						duration: 1,
						ease: 'power2.out',
						scrollTrigger: {
							trigger: element,
							start: 'top 80%',
							once: true,
						},
					},
				)
			})
		}
	</script>
</Layout>
