---
import Layout from '@/layouts/Layout.astro'
---

<Layout title="Página não encontrada | YESS Eventos" noindex>
	<main id="conteudo" class="grid min-h-screen place-items-center px-6 text-center">
		<div>
			<p class="mb-4 text-sm font-bold tracking-[0.18em] text-accent uppercase">Erro 404</p>
			<h1 class="text-5xl font-extrabold tracking-[-0.05em]">Página não encontrada</h1>
			<a href="/" class="mt-8 inline-flex rounded-full bg-accent px-6 py-3 font-bold text-white">
				Voltar ao início
			</a>
		</div>
	</main>
</Layout>
