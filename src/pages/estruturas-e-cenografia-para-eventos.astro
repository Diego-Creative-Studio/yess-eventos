---
import Layout from '@/layouts/Layout.astro'
import ServiceAreas from '@/components/ServiceAreas.astro'
import ServiceSchema from '@/components/ServiceSchema.astro'
import Etiqueta from '@/components/Etiqueta.astro'
import Icon from '@/components/Icon.astro'
import LightHalo from '@/components/LightHalo.astro'
import SectionIntegracaoServico from '@/components/sections/servicos/SectionIntegracaoServico.astro'
import SectionHeroServico from '@/components/sections/servicos/SectionHeroServico.astro'
import SectionEntregaServico from '@/components/sections/servicos/SectionEntregaServico.astro'
import SectionProcessoServico from '@/components/sections/servicos/SectionProcessoServico.astro'
import SectionPerguntasServico from '@/components/sections/servicos/SectionPerguntasServico.astro'
import SectionChamadaServico from '@/components/sections/servicos/SectionChamadaServico.astro'
import imagem from '@/assets/painel-led/projeto-estrutura-integrada.jpg'
const opcoes = [
	{
		titulo: 'Box Truss Q15, Q25 e Q30',
		icone: 'estrutura' as const,
		descricao:
			'Estruturas para compor o projeto do evento e a montagem audiovisual. A escolha considera a aplicação, o espaço e as necessidades técnicas.',
	},
	{
		titulo: 'Praticáveis para palcos',
		icone: 'montagem' as const,
		descricao:
			'Módulos para a composição de palcos e áreas de apresentação. Dimensões, disposição e acessos são alinhados ao projeto.',
	},
	{
		titulo: 'Backdrops',
		icone: 'medida' as const,
		descricao:
			'Montagem de fundo de palco ou de apresentação conforme o projeto. Envie as medidas e a proposta visual para definir o escopo.',
	},
]
---

<Layout
	title="Estruturas e Cenografia para Eventos | YESS"
	description="Montagem de Box Truss Q15, Q25 e Q30, praticáveis e backdrops para eventos em São Paulo e Guarulhos, com planejamento, montagem e desmontagem."
>
	<main id="conteudo" class="overflow-hidden">
		<ServiceSchema
			name="Estruturas e cenografia para eventos"
			description="Montagem de Box Truss Q15, Q25 e Q30, praticáveis e backdrops para eventos em São Paulo e Guarulhos, com planejamento, montagem e desmontagem."
		/>
		<SectionHeroServico
			boxTruss
			tituloDestaque="Estrutura para o seu evento."
			titulo="Montagem que acompanha o projeto."
			descricao="Box Truss, praticáveis para palcos e backdrops para feiras, congressos, convenções e apresentações. A YESS organiza a estrutura do planejamento à desmontagem."
			imagem={imagem}
			textoAlternativoImagem="Estrutura audiovisual instalada em palco de evento"
			textoBotao="Solicitar orçamento"
			linkBotao="/contato/#canais"
		>
			<Etiqueta
				slot="etiqueta"
				texto="Estruturas e cenografia para eventos"
				corFundo="bg-stroke"
				corTexto="text-foreground"
				corBolinha="bg-warm"
				class="self-center lg:self-start"
			/>
		</SectionHeroServico>
		<section aria-labelledby="solucoes" class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5">
			<div
				class="relative mx-auto w-full overflow-hidden rounded-3xl border-2 border-stroke bg-linear-to-br from-background to-primary-soft p-6 md:p-10 lg:max-w-345 lg:p-12"
			>
				<LightHalo
					data-animate={false}
					class="top-0 right-0"
					color="primary"
					size="md"
					intensity="subtle"
				/>
				<div
					data-animate="fade-left"
					class="relative z-10 mx-auto max-w-3xl text-center lg:mx-0 lg:text-left"
				>
					<p class="text-sm font-semibold text-warm uppercase">Do briefing à execução</p>
					<h2 id="solucoes" data-motion-title class="mt-2 text-3xl text-foreground lg:text-4xl">
						Estruturas e elementos de apoio
					</h2>
					<p class="text-base text-muted lg:text-lg">
						O formato do evento, o espaço disponível e os equipamentos previstos orientam a escolha
						da estrutura. A configuração e a disponibilidade são definidas no orçamento.
					</p>
				</div>
				<ol class="relative z-10 mt-8 grid gap-4 lg:grid-cols-3">
					{
						opcoes.map((opcao, indice) => (
							<li
								data-animate="fade-up"
								data-animate-delay={indice * 0.12}
								class:list={[
									'flex flex-col rounded-3xl p-6 text-center lg:p-8 lg:text-left',
									indice === 1
										? 'bg-primary'
										: indice === 2
											? 'bg-primary-soft'
											: 'border border-stroke bg-surface-alt/80',
								]}
							>
								<div class="flex items-center justify-center gap-4 lg:justify-between">
									<p
										class:list={[
											'text-5xl font-extrabold lg:text-6xl',
											indice === 1 ? 'text-foreground' : 'text-primary',
										]}
									>
										{String(indice + 1).padStart(2, '0')}
									</p>
									<span
										aria-hidden="true"
										class:list={[
											'flex size-12 shrink-0 items-center justify-center rounded-full text-white',
											indice === 1
												? 'bg-white/15'
												: indice === 2
													? 'bg-background/50'
													: 'bg-primary-soft',
										]}
									>
										<Icon name={opcao.icone} class="size-6" />
									</span>
								</div>
								<h3 class="mt-6 text-xl text-foreground lg:text-2xl">{opcao.titulo}</h3>
								<p
									class:list={[
										'mt-2 text-sm leading-6 lg:text-base',
										indice === 1 ? 'text-white' : 'text-foreground/75',
									]}
								>
									{opcao.descricao}
								</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>
		<SectionEntregaServico
			etiqueta="Entrega coordenada"
			titulo="Da leitura do espaço à montagem"
			descricao="Coordenamos a estrutura com os equipamentos e com o cronograma do local, reunindo montagem, testes e desmontagem em uma entrega planejada."
			itens={[
				{
					icone: 'medida',
					titulo: 'Leitura do espaço',
					descricao: 'Medidas, acessos e área de montagem orientam a configuração.',
				},
				{
					icone: 'estrutura',
					titulo: 'Estrutura definida no projeto',
					descricao: 'Box Truss, praticáveis e backdrop selecionados conforme a aplicação.',
				},
				{
					icone: 'montagem',
					titulo: 'Montagem coordenada',
					descricao: 'Etapas alinhadas ao cronograma e aos demais equipamentos.',
				},
				{
					icone: 'equipe',
					titulo: 'Desmontagem organizada',
					descricao: 'Desmontagem planejada com a produção e com o local.',
				},
			]}
			nota="Atendimento na capital, com ênfase nas zonas Sul, Oeste e Norte, em Guarulhos, na Grande São Paulo e no interior."
			imagem={imagem}
			textoAlternativoImagem="Estrutura audiovisual instalada em palco de evento"
		/>
		<SectionProcessoServico
			etiqueta="Nosso processo"
			titulo="Do planejamento à desmontagem"
			descricao="Coordenamos a estrutura com os equipamentos e com o cronograma do local, reunindo montagem, testes e desmontagem em uma entrega planejada."
			etapas={[
				{
					numero: '01',
					titulo: 'Briefing e medidas',
					descricao: 'Recebemos o formato, as medidas e as necessidades do evento.',
				},
				{
					numero: '02',
					titulo: 'Definição da estrutura',
					descricao: 'Alinhamos os elementos e a configuração previstos no projeto.',
				},
				{
					numero: '03',
					titulo: 'Montagem',
					descricao: 'Organizamos entrega, montagem e integração com o audiovisual.',
				},
				{
					numero: '04',
					titulo: 'Desmontagem',
					descricao: 'Coordenamos o encerramento e a desmontagem da estrutura.',
				},
			]}
		/>
		<SectionIntegracaoServico
			titulo="Uma entrega audiovisual integrada"
			descricao="Estrutura, painel de LED, som e iluminação podem fazer parte do mesmo projeto. O orçamento define os equipamentos e as etapas necessárias para o seu evento."
			secundario={{
				label: 'Conhecer os projetos técnicos e 3D',
				href: '/projetos-tecnicos-para-eventos/',
			}}
		/>
		<SectionPerguntasServico
			titulo="Perguntas frequentes"
			perguntas={[
				{
					pergunta: 'Quais estruturas a YESS oferece?',
					resposta:
						'O inventário informado inclui Box Truss Q15, Q25 e Q30, praticáveis para montagem de palcos e backdrops. A configuração e a disponibilidade são confirmadas para cada projeto.',
				},
				{
					pergunta: 'A YESS realiza a montagem de backdrop?',
					resposta:
						'Sim. A YESS monta backdrop. Envie as medidas e a proposta do evento para definir materiais, montagem e demais itens incluídos no orçamento.',
				},
				{
					pergunta: 'O serviço inclui montagem e desmontagem?',
					resposta:
						'Sim. A entrega contempla planejamento, entrega, montagem e desmontagem, com o escopo e o cronograma definidos no orçamento.',
				},
				{
					pergunta: 'O que preciso enviar para solicitar orçamento?',
					resposta:
						'Informe a data, o local, as medidas disponíveis, o tipo de evento e a estrutura desejada. Se já houver projeto ou desenho, envie para análise da equipe.',
				},
			]}
		/>
		<SectionChamadaServico
			titulo="Vamos planejar a estrutura do seu evento?"
			descricao="Envie data, local, medidas e o projeto disponível. A equipe orienta a configuração e prepara o orçamento."
			textoBotao="Solicitar projeto e orçamento"
			linkBotao="/contato/#canais"
		/>
		<ServiceAreas service="estrutura-e-cenografia-para-eventos" />
	</main>
</Layout>
