---
import Layout from '@/layouts/Layout.astro'
import ServiceAreas from '@/components/ServiceAreas.astro'
import Etiqueta from '@/components/Etiqueta.astro'
import Button from '@/components/Button.astro'
import Icon from '@/components/Icon.astro'
import LightHalo from '@/components/LightHalo.astro'
import { eventEquipment } from '@/data/event-equipment'
import SectionHeroServico from '@/components/sections/servicos/SectionHeroServico.astro'
import SectionProcessoServico from '@/components/sections/servicos/SectionProcessoServico.astro'
import SectionPerguntasServico from '@/components/sections/servicos/SectionPerguntasServico.astro'
import SectionChamadaServico from '@/components/sections/servicos/SectionChamadaServico.astro'
import imagemHero from '@/assets/yess/painel-led-panoramico.jpg'
import imagemProjeto from '@/assets/painel-led/projeto-painel-corporativo.jpg'
import imagemEntrega from '@/assets/yess/etapa-entrega.jpg'
import imagemMontagem from '@/assets/yess/etapa-montagem.jpg'
import imagemOperacao from '@/assets/painel-led/projeto-operacao-tecnica.jpg'

const categorias = [
	{
		titulo: 'Painéis de LED P2 e P3',
		descricao:
			'Painéis de LED e processadoras de vídeo para palcos, estandes e apresentações. Definimos o painel conforme distância do público, dimensões e conteúdo.',
		itens: ['Painéis de LED P2 e P3', 'Processadoras de vídeo', 'Montagem e operação técnica'],
		href: '/paineis-de-led-p2-e-p3/',
	},
	{
		titulo: 'Sonorização para eventos',
		descricao:
			'Sistemas de áudio para reuniões, plenárias, congressos e eventos com público de até 1.000 pessoas, conforme o espaço e as necessidades de cobertura.',
		itens: [
			'Caixas de som QSC e EV e sistemas de P.A.',
			'Mesas de som digitais',
			'Microfones Shure e Sennheiser',
		],
		href: '/som-e-iluminacao/',
	},
	{
		titulo: 'Iluminação para eventos',
		descricao:
			'Equipamentos de iluminação com montagem e operação para valorizar o palco, os apresentadores e os diferentes momentos da programação.',
		itens: ['Moving heads 7R, 9R e 14R', 'Par LEDs e ribaltas', 'Mesas de luz digitais'],
		href: '/som-e-iluminacao/',
	},
	{
		titulo: 'TVs, monitores e projetores',
		descricao:
			'Telas para estandes, salas e apresentações. A escolha considera iluminação do ambiente, distância de visualização e conteúdo.',
		itens: ['TVs de 42, 55 e 65 polegadas', 'Projetores Epson', 'Instalação e testes de sinal'],
		href: '/tvs-e-monitores/',
	},
	{
		titulo: 'Estruturas e cenografia',
		descricao:
			'Estruturas e elementos de apoio dimensionados para o projeto, com montagem e desmontagem coordenadas com a programação do local.',
		itens: ['Box Truss Q15, Q25 e Q30', 'Praticáveis para palcos', 'Backdrops'],
		href: '/estruturas-e-cenografia-para-eventos/',
	},
	{
		titulo: 'Projetos técnicos e 3D',
		descricao:
			'Elaboramos projetos novos e executamos projetos previamente desenvolvidos, acompanhando a entrega do planejamento à desmontagem.',
		itens: [
			'Projetos técnicos, 3D e AutoCAD',
			'Montagem e operação audiovisual',
			'Sonoplastia de plenárias, convenções e congressos',
		],
		href: '/projetos-tecnicos-para-eventos/',
	},
]

const equipamentosEvento = [
	{
		href: '/paineis-de-led-p2-e-p3/',
		titulo: 'Painel de LED P2 e P3',
		resumo: 'Imagem para palcos, estandes e apresentações.',
	},
	...eventEquipment.map((equipment) => ({
		href: `/equipamentos/${equipment.slug}/`,
		titulo: `${equipment.name} para eventos`,
		resumo: equipment.summary,
	})),
]

const regioesAtendidas = [
	{ titulo: 'Capital', texto: 'Ênfase nas zonas Sul, Oeste e Norte.' },
	{ titulo: 'Guarulhos', texto: 'Uma das áreas de maior atuação.' },
	{ titulo: 'Grande São Paulo', texto: 'ABC, Alphaville, Osasco e região.' },
	{ titulo: 'Interior e litoral', texto: 'Montagem programada com antecedência.' },
]

const baseURL = new URL('/', Astro.site ?? Astro.url.origin)
const pageURL = new URL('/estrutura-audiovisual-para-eventos/', baseURL)
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Service',
			'@id': `${pageURL.href}#service`,
			name: 'Produção e montagem audiovisual para eventos',
			serviceType: 'Planejamento, montagem e operação audiovisual para eventos',
			url: pageURL.href,
			provider: { '@id': `${baseURL.href}#organization` },
			areaServed: [
				{ '@type': 'State', name: 'São Paulo' },
				{ '@type': 'City', name: 'São Paulo' },
				{ '@type': 'City', name: 'Guarulhos' },
			],
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Início', item: baseURL.href },
				{
					'@type': 'ListItem',
					position: 2,
					name: 'Estrutura audiovisual para eventos',
					item: pageURL.href,
				},
			],
		},
	],
}
---

<Layout
	title="Estrutura Audiovisual para Eventos | YESS"
	description="Painel de LED, som, iluminação, TVs, projetores e estruturas em São Paulo capital e interior, com entrega, instalação e acompanhamento técnico."
>
	<main id="conteudo" class="overflow-hidden">
		<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
		<SectionHeroServico
			tituloDestaque="Estrutura audiovisual para eventos."
			titulo="Do projeto à desmontagem."
			descricao="Painéis de LED, som, iluminação, TVs, projetores e estruturas em São Paulo capital e interior. Produção e montagem audiovisual com entrega, instalação e acompanhamento técnico, sem retirada pelo cliente."
			imagem={imagemHero}
			textoAlternativoImagem="Palco de evento com painel de LED e estrutura audiovisual"
			etapas={[
				{
					titulo: 'Projeto',
					legenda: 'Briefing, medidas e definição dos equipamentos do evento.',
					imagem: imagemProjeto,
					textoAlternativo: 'Projeto de painel de LED para evento corporativo',
				},
				{
					titulo: 'Entrega',
					legenda: 'Equipamentos levados até o local, sem retirada pelo cliente.',
					imagem: imagemEntrega,
					textoAlternativo: 'Estrutura de treliça com caixas de som e moving heads sendo instalada',
				},
				{
					titulo: 'Montagem',
					legenda: 'Box Truss, painel de LED, som e luz instalados no espaço.',
					imagem: imagemMontagem,
					textoAlternativo: 'Pórtico de Box Truss montado com painel e cases de equipamento',
				},
				{
					titulo: 'Operação',
					legenda: 'Equipe técnica acompanhando o evento do começo ao fim.',
					imagem: imagemOperacao,
					textoAlternativo: 'Operação técnica audiovisual durante o evento',
				},
				{
					titulo: 'Desmontagem',
					legenda: 'Recolhimento completo da estrutura ao final do evento.',
					imagem: imagemHero,
					textoAlternativo: 'Palco de evento com painel de LED e estrutura audiovisual',
				},
			]}
			textoBotao="Solicitar orçamento"
			linkBotao="/contato/#canais"
		>
			<Etiqueta
				slot="etiqueta"
				texto="Produção audiovisual para eventos"
				corFundo="bg-stroke"
				corTexto="text-foreground"
				corBolinha="bg-warm"
				class="self-center lg:self-start"
			/>
		</SectionHeroServico>
		<section aria-labelledby="catalogo" class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5">
			<div
				class="relative mx-auto w-full overflow-hidden rounded-3xl border-2 border-stroke bg-linear-to-br from-background to-primary-soft p-6 md:p-10 lg:max-w-345 lg:p-12"
			>
				<LightHalo
					data-animate={false}
					class="top-0 right-0"
					color="primary"
					size="md"
					intensity="subtle"
				/>
				<div data-animate="fade-left" class="relative z-10 text-center lg:text-left">
					<p class="text-sm font-semibold text-primary uppercase">Catálogo audiovisual</p>
					<h2 id="catalogo" data-motion-title class="mt-2 text-3xl text-foreground lg:text-4xl">
						Equipamentos e serviços para cada etapa
					</h2>
					<p class="mx-auto mt-4 max-w-3xl text-base text-muted lg:mx-0 lg:text-lg">
						O painel de LED é uma das principais frentes da YESS. Combinamos imagem, som, luz e
						estrutura conforme o formato do evento, o público e as condições do espaço. Consulte a
						disponibilidade dos equipamentos para sua data.
					</p>
				</div>

				<ol class="relative z-10 mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{
						categorias.map((categoria, indice) => (
							<li
								data-animate="fade-up"
								data-animate-delay={indice * 0.06}
								class:list={[
									'flex flex-col rounded-3xl p-6 text-center transition-colors md:text-left lg:p-7',
									indice === 0
										? 'bg-primary'
										: 'border border-stroke bg-surface-alt/80 hover:border-primary',
								]}
							>
								<p
									class:list={[
										'text-5xl font-extrabold',
										indice === 0 ? 'text-foreground' : 'text-primary',
									]}
								>
									{String(indice + 1).padStart(2, '0')}
								</p>
								<h3 class="mt-5 text-xl text-foreground lg:text-2xl">{categoria.titulo}</h3>
								<p
									class:list={[
										'mt-2 text-sm leading-6',
										indice === 0 ? 'text-white' : 'text-foreground/75',
									]}
								>
									{categoria.descricao}
								</p>
								<ul class="mt-5 space-y-2.5 text-sm text-foreground">
									{categoria.itens.map((item) => (
										<li class="flex items-start justify-center gap-3 md:justify-start">
											<span
												aria-hidden="true"
												class:list={[
													'mt-1.5 size-1.5 shrink-0 rounded-full',
													indice === 0 ? 'bg-white' : 'bg-primary',
												]}
											/>
											<span class="text-left">{item}</span>
										</li>
									))}
								</ul>
								<a
									href={categoria.href}
									class:list={[
										'group mt-auto inline-flex items-center justify-center gap-2 self-center pt-7 font-title text-sm font-semibold md:self-start',
										indice === 0 ? 'text-white' : 'text-primary hover:text-foreground',
									]}
								>
									Conhecer o serviço
									<Icon
										name="arrow"
										class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
									/>
								</a>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section aria-labelledby="equipamentos-evento" class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5">
			<div
				class="mx-auto grid w-full gap-8 overflow-hidden rounded-3xl border-2 border-stroke bg-surface p-6 md:p-10 lg:max-w-345 lg:grid-cols-[22rem_1fr] lg:gap-12 lg:p-12"
			>
				<div data-animate="fade-left" class="text-center lg:text-left">
					<p class="text-sm font-semibold text-warm uppercase">Equipamentos</p>
					<h2 id="equipamentos-evento" data-motion-title class="mt-2 text-3xl text-foreground">
						Equipamentos que compõem seu evento
					</h2>
					<p class="mt-4 text-muted">
						Os equipamentos fazem parte da produção e montagem do seu evento. A equipe entrega,
						instala e acompanha a operação técnica.
					</p>
					<p
						class="mt-5 rounded-small border border-primary/40 bg-primary/10 p-4 text-sm font-semibold text-text-secondary"
					>
						Não oferecemos aluguel para retirada: tudo é entregue, montado e acompanhado pela nossa
						equipe.
					</p>
				</div>

				<ul class="grid content-start gap-2 md:grid-cols-2 lg:border-l lg:border-stroke lg:pl-12">
					{
						equipamentosEvento.map((item, indice) => (
							<li data-animate="fade-up" data-animate-delay={indice * 0.05}>
								<a
									href={item.href}
									class="group grid h-full grid-cols-[32px_1fr_14px] items-center gap-3 rounded-2xl border border-transparent px-3 py-3 transition-colors duration-200 hover:border-stroke hover:bg-surface-alt"
								>
									<span class="flex size-8 items-center justify-center rounded-full bg-primary-soft font-title text-xs font-bold text-primary">
										{String(indice + 1).padStart(2, '0')}
									</span>
									<span class="min-w-0">
										<span class="block font-title text-sm font-semibold text-foreground">
											{item.titulo}
										</span>
										<span class="mt-0.5 block text-xs leading-5 text-muted">{item.resumo}</span>
									</span>
									<Icon
										name="arrow"
										class="size-3 text-muted transition-[color,transform] duration-200 group-hover:translate-x-0.5 group-hover:text-primary"
									/>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section aria-labelledby="atendimento" class="px-3 py-8 md:px-8 lg:px-16 lg:py-7.5">
			<div
				class="relative mx-auto grid w-full gap-8 overflow-hidden rounded-3xl border-2 border-primary bg-linear-to-br from-background to-primary-soft p-6 md:p-10 lg:max-w-345 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:gap-12 lg:p-12"
			>
				<LightHalo
					data-animate={false}
					class="bottom-0 left-0"
					color="primary"
					size="md"
					intensity="medium"
				/>
				<div data-animate="fade-left" class="relative z-10 text-center lg:text-left">
					<p class="text-sm font-semibold text-primary uppercase">Área de atendimento</p>
					<h2 id="atendimento" data-motion-title class="mt-2 text-3xl text-foreground lg:text-4xl">
						Atendimento em São Paulo: capital e interior
					</h2>
					<p class="mt-4 text-base text-muted lg:text-lg">
						Atendemos a capital e o interior de São Paulo, incluindo Guarulhos, com ênfase nas zonas
						Sul, Oeste e Norte da capital. O orçamento considera os equipamentos, o local, os
						acessos para montagem, a programação e a equipe técnica necessária.
					</p>
					<p class="mt-4 text-base text-muted lg:text-lg">
						Para eventos corporativos, a YESS também coordena os sistemas em uma entrega integrada,
						do briefing à desmontagem.
					</p>
					<Button
						href="/solucoes-corporativas/"
						label="Soluções para eventos corporativos"
						variant="tertiary"
						arrow
						animation="shine"
						class="mt-6 w-full md:w-auto"
					/>
				</div>

				<ul class="relative z-10 grid gap-3 sm:grid-cols-2">
					{
						regioesAtendidas.map((regiao, indice) => (
							<li
								data-animate="scale"
								data-animate-delay={0.1 + indice * 0.08}
								class="flex flex-col items-center gap-3 rounded-small border border-stroke bg-surface/70 p-5 text-center sm:items-start sm:text-left"
							>
								<span class="flex size-10 items-center justify-center rounded-full bg-primary-soft text-white">
									<Icon name="localizacao" class="size-5" />
								</span>
								<span>
									<span class="block font-title font-semibold text-foreground">
										{regiao.titulo}
									</span>
									<span class="mt-1 block text-sm text-muted">{regiao.texto}</span>
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>
		<SectionProcessoServico
			etiqueta="Entrega completa"
			titulo="Planejamento, montagem e operação"
			descricao="A YESS coordena o atendimento desde a produção do projeto até a desmontagem."
			etapas={[
				{
					numero: '01',
					titulo: 'Briefing',
					descricao: 'Data, local, público e programação orientam o escopo.',
				},
				{
					numero: '02',
					titulo: 'Projeto',
					descricao: 'Selecionamos equipamentos e planejamos a estrutura técnica.',
				},
				{
					numero: '03',
					titulo: 'Montagem e testes',
					descricao: 'Entregamos, instalamos e verificamos áudio, imagem e iluminação.',
				},
				{
					numero: '04',
					titulo: 'Operação e desmontagem',
					descricao: 'Acompanhamos o evento e desmontamos os equipamentos ao final.',
				},
			]}
		/>
		<SectionPerguntasServico
			titulo="Perguntas frequentes sobre a estrutura audiovisual"
			perguntas={[
				{
					pergunta: 'Quais equipamentos podem compor meu evento?',
					resposta:
						'A YESS oferece painéis de LED P2 e P3, caixas e mesas de som, microfones, iluminação, TVs, projetores, processadoras, Box Truss, praticáveis e backdrops. Consulte disponibilidade e dimensionamento para sua data.',
				},
				{
					pergunta: 'Posso retirar o equipamento e instalar por conta própria?',
					resposta:
						'Não. A YESS trabalha somente com equipamentos instalados ou pacotes para eventos. A entrega inclui instalação e acompanhamento de um técnico, com o escopo definido no orçamento.',
				},
				{
					pergunta: 'Quais informações preciso enviar para o orçamento?',
					resposta:
						'Informe a data, a cidade, o local, o formato do evento, o público estimado e os equipamentos desejados. Se já houver projeto, medidas ou programação, envie também.',
				},
				{
					pergunta: 'Como funciona o pagamento?',
					resposta:
						'É cobrada uma entrada, e o restante é pago no dia do evento. As condições são apresentadas no orçamento.',
				},
			]}
		/>
		<SectionChamadaServico
			titulo="Vamos dimensionar os equipamentos do seu evento?"
			descricao="Envie data, cidade, público estimado e o que você precisa apresentar. A equipe orienta o projeto e prepara o orçamento."
			textoBotao="Solicitar projeto e orçamento"
			linkBotao="/contato/#canais"
		/>
		<ServiceAreas service="audiovisual-para-eventos" />
	</main>
</Layout>
