{
	"useTabs": true,
	"singleQuote": true,
	"semi": false,
	"printWidth": 100,
	"htmlWhitespaceSensitivity": "strict",
	"plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "./src/styles/global.css",
	"overrides": [
		{
			"files": "docs/gtm/yess-consent-template.js",
			"options": {
				"semi": true,
				"trailingComma": "none"
			}
		},
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		}
	]
}
